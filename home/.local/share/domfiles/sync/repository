#!/bin/sh

# Returns success when Git reports that the domfiles checkout is on `master`.
# Explains why the update was skipped unless Git is unavailable
can_update_repository() (
  if ! __is_callable git; then
    return 1
  fi

  # Compare the full ref because a tag named `master` can make Git report
  # `heads/master` for the branch
  if ref="$(git -C "$DOMFILES" symbolic-ref --quiet HEAD)"; then
    if [ "$ref" = refs/heads/master ]; then
      return
    fi

    __print_info "Skipping repository update on branch \`${ref#refs/heads/}\`"
  else
    status="$?"

    if [ "$status" -eq 1 ]; then
      __print_info 'Skipping repository update because `HEAD` does not reference a branch'
    else
      __print_error 'Failed to identify the current branch'
    fi
  fi

  return 1
)

# Prints the PIDs of descendants of `$1`, one per line. An optional child PID
# `$2` excludes that child and its descendants. If `$2` is no longer a direct
# child of `$1`, prints nothing
list_descendant_processes() (
  ps -A -o pid= -o ppid= | awk -v root="$1" -v skip="${2-}" '
    {
      pids[NR] = $1
      parents[$1] = $2
    }

    END {
      if (skip != "" && parents[skip] != root) {
        exit
      }

      tree[root] = 1

      do {
        found = 0

        for (i = 1; i <= NR; i++) {
          pid = pids[i]

          if (pid != skip && !(pid in tree) && (parents[pid] in tree)) {
            tree[pid] = 1
            found = 1
            print pid
          }
        }
      } while (found)
    }
  '
)

# Runs Git in the domfiles checkout with arguments `$@` and a one-minute limit,
# printing the command first. Returns 124 only when the limit stopped Git.
# Otherwise returns Git’s status, reporting Git’s own 124 as 1
run_git_with_limit() (
  helper_pid="$(exec sh -c 'printf "%s\n" "$PPID"')" || return

  # Keep the watchdog off the output so it never holds a caller’s pipe open
  watch_git_with_limit "$helper_pid" 60 < /dev/null > /dev/null 2>&1 &
  watchdog_pid="$!"
  status=0
  __print_command git -C "$DOMFILES" "$@"

  # Give Git the original stderr in a separate process so dash cannot print its
  # own termination notice there
  exec 3>&2 2> /dev/null
  (exec git -C "$DOMFILES" "$@" 2>&3 3>&-) || status="$?"

  # Stop the watchdog, or let it finish stopping Git
  kill -s TERM "$watchdog_pid" || :

  if wait "$watchdog_pid" && [ "$status" -ne 0 ]; then
    return 124
  fi

  # Reserve 124 for the limit
  if [ "$status" -eq 124 ]; then
    return 1
  fi

  return "$status"
)

# Scans the descendants of `$1`, excluding child `$2` and its subtree. Gives the
# processes it finds one second to exit on `TERM` before sending `KILL`.
# Processes that left the tree before the scan or start during termination may
# survive. Returns failure if the scan finds no matching processes
stop_descendant_processes() (
  root="$1"
  skip="$2"
  found=true
  stopped=' '
  set --

  while [ "$found" = true ]; do
    found=false

    for pid in $(list_descendant_processes "$root" "$skip"); do
      case "$stopped" in
        *" $pid "*) ;;
        *)
          kill -s STOP "$pid" 2> /dev/null || :
          found=true
          stopped="$stopped$pid "
          set -- "$@" "$pid"
          ;;
      esac
    done
  done

  if [ $# -eq 0 ]; then
    return 1
  fi

  kill -s TERM "$@" 2> /dev/null || :
  kill -s CONT "$@" 2> /dev/null || :
  sleep 1
  kill -s KILL "$@" 2> /dev/null || :
)

# Rebases the domfiles checkout onto its upstream, preserving tracked changes.
# With an SSH key pair, switches `origin` to SSH only after verifying access.
# Can skip an update or recover from a failed rebase and still return success.
# Returns failure if preparing the remote, reading the current revision,
# checking skipped files, or restoring the checkout fails
update_repository() (
  stash_failed=false
  stashed_changes=false

  # Ensure the remote uses SSH
  if __is_ssh_configured; then
    current="$(git -C "$DOMFILES" remote get-url origin)" || return
    updated="$(__string_replace "$current" 'https://github.com/' 'git@github.com:')" || return
    updated="$(__string_replace "$updated" 'porada/dotfiles' 'porada/domfiles')" || return

    if [ "$current" = "$updated" ]; then
      __print_confirmation "$current"
    else
      verify_status=0
      run_git_with_limit ls-remote "$updated" HEAD > /dev/null || verify_status="$?"

      if [ "$verify_status" -eq 0 ]; then
        __ git -C "$DOMFILES" remote set-url origin "$updated" || return
      elif [ "$verify_status" -eq 124 ]; then
        __print_error "Failed to verify SSH access to \`$updated\` within 1 minute. Leaving \`origin\` as \`$current\`"
      else
        __print_error "Failed to verify SSH access to \`$updated\`. Leaving \`origin\` as \`$current\`"
      fi
    fi
  fi

  __print_heading_dimmed 'Fetching the latest changes'
  current_revision="$(__domfiles_revision)" || return
  fetch_status=0
  run_git_with_limit fetch --quiet || fetch_status="$?"

  if [ "$fetch_status" -eq 124 ]; then
    __print_error 'Failed to fetch the latest changes within 1 minute. Continuing with the local checkout'
  elif [ "$fetch_status" -ne 0 ]; then
    __print_error 'Failed to fetch the latest changes. Continuing with the local checkout'
  elif __ git -C "$DOMFILES" merge-base --is-ancestor '@{u}' HEAD; then
    __print_confirmation 'Up to date'
  else
    merge_base_status="$?"

    if [ "$merge_base_status" -ne 1 ]; then
      __print_error 'Failed to compare the local and upstream revisions'
    else
      skipped_files="$(__git_skipped_files "$DOMFILES")" || return

      if [ -n "$skipped_files" ]; then
        __print_warning 'The repository contains skipped files. Unskip them before updating'
      else
        __print_heading 'Updating the repository'

        if ! __domfiles_is_clean; then
          __print_warning 'The repository contains uncommitted changes'

          if ! stash_list="$(git -C "$DOMFILES" stash list --format='%H')"; then
            __print_error 'Failed to stash uncommitted changes'
            stash_failed=true
          elif ! __ git -C "$DOMFILES" stash; then
            __print_error 'Failed to stash uncommitted changes'
            stash_failed=true
          elif ! updated_stash_list="$(git -C "$DOMFILES" stash list --format='%H')"; then
            __print_error 'Failed to verify stashed changes'
            stash_failed=true
            stashed_changes=true
          elif [ "$updated_stash_list" != "$stash_list" ]; then
            stashed_changes=true
          fi
        fi

        if [ "$stash_failed" = false ]; then
          if __ git -C "$DOMFILES" rebase; then
            __print_confirmation 'Repository updated'
          else
            echo
            __print_error 'Failed to update the repository'

            git_dir="$(git -C "$DOMFILES" rev-parse --absolute-git-dir)" || return

            if [ -d "$git_dir/rebase-apply" ] || [ -d "$git_dir/rebase-merge" ]; then
              __ git -C "$DOMFILES" rebase --abort || return
            fi
          fi
        fi
      fi
    fi
  fi

  if [ "$stashed_changes" = true ]; then
    if __ git -C "$DOMFILES" stash pop --index --quiet; then
      __print_confirmation 'Changes restored'
    else
      __print_error 'Failed to restore uncommitted changes'

      __print_heading_dimmed 'Restoring the original state'
      skipped_files="$(__git_skipped_files "$DOMFILES")" || return

      if [ -n "$skipped_files" ]; then
        __print_error \
          'The repository contains skipped files. Unskip them before restoring the original state'
        return 1
      fi

      __ git -C "$DOMFILES" reset --hard "$current_revision" || {
        status="$?"
        __print_error 'Failed to restore the original state'
        return "$status"
      }

      if __ git -C "$DOMFILES" stash pop --index --quiet; then
        __print_confirmation 'Original state restored'
      else
        status="$?"
        __print_error 'Failed to restore the original state'
        return "$status"
      fi
    fi
  fi
)

# Waits `$2` seconds before stopping the other descendants of `$1`. The watchdog
# stays a direct child so it can verify its parent. `TERM` cancels the wait.
# Once termination starts, the watchdog ignores `TERM` and returns success if it
# found processes to stop
watch_git_with_limit() {
  watchdog_pid="$(exec sh -c 'printf "%s\n" "$PPID"')" || return

  # shellcheck disable=SC2046
  trap 'kill -s TERM $(list_descendant_processes "$watchdog_pid") 2> /dev/null; exit 1' TERM
  sleep "$2" &
  wait "$!" || return

  # Finish stopping Git even if it exits in the meantime
  trap '' TERM
  stop_descendant_processes "$1" "$watchdog_pid"
}
