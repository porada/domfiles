#!/bin/sh

# Returns success when Git reports that the domfiles checkout is on `master`.
# Explains why the update was skipped unless Git is unavailable
can_update_repository() (
  if ! __is_callable git; then
    return 1
  fi

  # Compare the full ref because a tag named `master` can make Git report
  # `heads/master` for the branch
  if ref="$(git -C "$DOMFILES" symbolic-ref --quiet HEAD)"; then
    if [ "$ref" = refs/heads/master ]; then
      return
    fi

    __print_info "Skipping repository update on branch \`${ref#refs/heads/}\`"
  else
    status="$?"

    if [ "$status" -eq 1 ]; then
      __print_info 'Skipping repository update because `HEAD` does not reference a branch'
    else
      __print_error 'Failed to identify the current branch'
    fi
  fi

  return 1
)

# Prints the PIDs of descendants of `$1`, one per line. An optional child PID
# `$2` excludes that child and its descendants. If `$2` is no longer a direct
# child of `$1`, prints nothing
list_descendant_processes() (
  ps -A -o pid= -o ppid= | awk -v root="$1" -v skip="${2-}" '
    {
      pids[NR] = $1
      parents[$1] = $2
    }

    END {
      if (skip != "" && parents[skip] != root) {
        exit
      }

      tree[root] = 1

      do {
        found = 0

        for (i = 1; i <= NR; i++) {
          pid = pids[i]

          if (pid != skip && !(pid in tree) && (parents[pid] in tree)) {
            tree[pid] = 1
            found = 1
            print pid
          }
        }
      } while (found)
    }
  '
)

# Runs Git in the domfiles checkout with arguments `$@` and a one-minute limit,
# printing the command first. Returns 124 only when the limit stopped Git.
# Otherwise returns Git’s status, reporting Git’s own 124 as 1
run_git_with_limit() (
  helper_pid="$(exec sh -c 'printf "%s\n" "$PPID"')" || return

  # Keep the watchdog off the output so it never holds a caller’s pipe open
  watch_git_with_limit "$helper_pid" 60 < /dev/null > /dev/null 2>&1 &
  watchdog_pid="$!"
  status=0
  __print_command git -C "$DOMFILES" "$@"

  # Give Git the original stderr in a separate process so dash cannot print its
  # own termination notice there
  exec 3>&2 2> /dev/null
  (exec git -C "$DOMFILES" "$@" 2>&3 3>&-) || status="$?"

  # Stop the watchdog, or let it finish stopping Git
  kill -s TERM "$watchdog_pid" || :

  if wait "$watchdog_pid" && [ "$status" -ne 0 ]; then
    return 124
  fi

  # Reserve 124 for the limit
  if [ "$status" -eq 124 ]; then
    return 1
  fi

  return "$status"
)

# Scans the descendants of `$1`, excluding child `$2` and its subtree. Gives the
# processes it finds one second to exit on `TERM` before sending `KILL`.
# Processes that left the tree before the scan or start during termination may
# survive. Returns failure if the scan finds no matching processes
stop_descendant_processes() (
  root="$1"
  skip="$2"
  found=true
  stopped=' '
  set --

  while [ "$found" = true ]; do
    found=false

    for pid in $(list_descendant_processes "$root" "$skip"); do
      case "$stopped" in
        *" $pid "*) ;;
        *)
          kill -s STOP "$pid" 2> /dev/null || :
          found=true
          stopped="$stopped$pid "
          set -- "$@" "$pid"
          ;;
      esac
    done
  done

  if [ $# -eq 0 ]; then
    return 1
  fi

  kill -s TERM "$@" 2> /dev/null || :
  kill -s CONT "$@" 2> /dev/null || :
  sleep 1
  kill -s KILL "$@" 2> /dev/null || :
)

# Verifies SSH access before changing `origin` and fetches the upstream before
# updating the checkout. Runs in the sync process so its signal traps can
# recover an interrupted switch
update_repository() {
  # Ensure the remote uses SSH
  if __is_ssh_configured; then
    update_current_url="$(git -C "$DOMFILES" remote get-url origin)" || return
    update_url="$(__string_replace "$update_current_url" 'https://github.com/' 'git@github.com:')" \
      || return
    update_url="$(__string_replace "$update_url" 'porada/dotfiles' 'porada/domfiles')" || return

    if [ "$update_current_url" = "$update_url" ]; then
      __print_confirmation "$update_current_url"
    else
      update_verify_status=0
      run_git_with_limit ls-remote "$update_url" HEAD > /dev/null || update_verify_status="$?"

      if [ "$update_verify_status" -eq 0 ]; then
        __ git -C "$DOMFILES" remote set-url origin "$update_url" || return
      elif [ "$update_verify_status" -eq 124 ]; then
        __print_error "Failed to verify SSH access to \`$update_url\` within 1 minute. Leaving \`origin\` as \`$update_current_url\`"
      else
        __print_error "Failed to verify SSH access to \`$update_url\`. Leaving \`origin\` as \`$update_current_url\`"
      fi
    fi
  fi

  __print_heading_dimmed 'Fetching the latest changes'
  update_fetch_status=0
  run_git_with_limit fetch --quiet || update_fetch_status="$?"

  if [ "$update_fetch_status" -eq 124 ]; then
    __print_error 'Failed to fetch the latest changes within 1 minute. Continuing with the local checkout'
    return
  elif [ "$update_fetch_status" -ne 0 ]; then
    __print_error 'Failed to fetch the latest changes. Continuing with the local checkout'
    return
  fi

  update_merge_base_status=0
  __ git -C "$DOMFILES" merge-base --is-ancestor '@{u}' HEAD || update_merge_base_status="$?"

  if [ "$update_merge_base_status" -eq 0 ]; then
    __print_confirmation 'Up to date'
    return
  elif [ "$update_merge_base_status" -ne 1 ]; then
    __print_error 'Failed to compare the local and upstream revisions'
    return
  fi

  update_skipped_files="$(__git_skipped_files "$DOMFILES")" || return

  if [ -n "$update_skipped_files" ]; then
    __print_warning 'The repository contains skipped files. Unskip them before updating'
    return
  fi

  __print_heading 'Updating the repository'
  apply_repository_update
}

# Waits `$2` seconds before stopping the other descendants of `$1`. The watchdog
# stays a direct child so it can verify its parent. `TERM` cancels the wait.
# Once termination starts, the watchdog ignores `TERM` and returns success if it
# found processes to stop
watch_git_with_limit() {
  watchdog_pid="$(exec sh -c 'printf "%s\n" "$PPID"')" || return

  # shellcheck disable=SC2046
  trap 'kill -s TERM $(list_descendant_processes "$watchdog_pid") 2> /dev/null; exit 1' TERM
  sleep "$2" &
  wait "$!" || return

  # Finish stopping Git even if it exits in the meantime
  trap '' TERM
  stop_descendant_processes "$1" "$watchdog_pid"
}
