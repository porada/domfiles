#!/bin/sh

# Enable strict mode
set -eu

# Ensure the library is sourced only once
if [ -n "${DOMFILES_BIN_DIR-}" ]; then
  printf '%s\n' '`domlib` is already defined' >&2
  exit 1
fi

# Resolve domfiles’ paths based on the caller’s location
DOMFILES_BIN_DIR="$(dirname "$(realpath "$0")")"
DOMFILES_HOME_DIR="$(dirname "$(dirname "$DOMFILES_BIN_DIR")")"
DOMFILES="$(dirname "$DOMFILES_HOME_DIR")"

# shellcheck disable=SC2034
DOMFILES_CONFIG_DIR="$DOMFILES_HOME_DIR/.config"

# shellcheck disable=SC2034
DOMFILES_PROJECTS_DIR="$HOME/Projects"

# Runs `$@`, printing the command beforehand
__() {
  if [ $# -eq 0 ]; then
    __print_error_and_exit '`__` requires at least one argument'
  fi

  __print_command "$@"

  if [ "$1" = 'brew' ]; then
    shift
    brew "$@"
  elif [ "$1" = 'pnpm' ]; then
    shift
    pnpm "$@"
  else
    command "$@"
  fi
}

# Applies standard permissions to directories and files
__chmod() {
  if [ -d "$1" ]; then
    __ chmod 700 "$1"
  elif [ -f "$1" ]; then
    __ chmod 600 "$1"
  fi
}

# Requests confirmation with `$1`. Returns success when confirmed
__confirm() {
  if [ $# -ne 1 ]; then
    __print_error_and_exit '`__confirm` requires one argument'
  fi

  (
    whitespace="$(printf ' \t')"

    while true; do
      __print_warning --inline -- "$1"
      __print_info --inline -- 'y/n'

      read_status=0
      response=''
      IFS= read -r response || read_status=$?

      # Accept a final response without a newline, matching Fish
      if [ "$read_status" -gt 1 ] || { [ "$read_status" -eq 1 ] && [ -z "$response" ]; }; then
        return 1
      fi

      response="${response#"${response%%[!"$whitespace"]*}"}"
      response="${response%"${response##*[!"$whitespace"]}"}"

      case "$response" in
        y | Y)
          return 0
          ;;
        n | N)
          return 1
          ;;
      esac
    done
  )
}

# Runs `domfiles` command `$1`
__domfiles() (
  if [ $# -eq 0 ]; then
    __print_error_and_exit '`__domfiles` requires at least one argument'
  fi

  command="$1"
  shift

  "$DOMFILES_BIN_DIR/domfiles-$command" "$@"
)

# Runs command `$1` from the `bin` directory
__domfiles_bin() (
  if [ $# -eq 0 ]; then
    __print_error_and_exit '`__domfiles_bin` requires at least one argument'
  fi

  command="$1"
  shift

  "$DOMFILES_BIN_DIR/$command" "$@"
)

# Changes the current directory to `bin`
__domfiles_cd_bin() {
  cd "$DOMFILES_BIN_DIR" \
    || __print_error_and_exit "Failed to change directory to \`$DOMFILES_BIN_DIR\`"
}

# Changes the current directory to the repository root
__domfiles_cd_root() {
  cd "$DOMFILES" \
    || __print_error_and_exit "Failed to change directory to \`$DOMFILES\`"
}

# Runs `lint_file` on remaining files or defaults from `lint_default_files`.
# Uses `$1` as the label
__domfiles_dev_lint() (
  if [ $# -eq 0 ]; then
    __print_error_and_exit '`__domfiles_dev_lint` requires a label'
  fi

  for callback in lint_default_files lint_file; do
    if ! command -v "$callback" > /dev/null 2>&1; then
      __print_error_and_exit "\`__domfiles_dev_lint\` requires the \`$callback\` callback"
    fi
  done

  lint_label="$1"
  shift

  if [ $# -eq 0 ]; then
    files="$(lint_default_files)" || exit $?

    if [ -n "$files" ]; then
      while IFS= read -r file; do
        set -- "$@" "$file"
      done << EOF
$files
EOF
    fi
  fi

  valid_count=0
  valid_file=''

  for file in "$@"; do
    if [ ! -f "$file" ] || [ -L "$file" ]; then
      continue
    fi

    valid_count="$((valid_count + 1))"
    valid_file="$file"
  done

  if [ "$valid_count" -eq 0 ]; then
    __print_info_and_exit 'No files to lint'
  elif [ "$valid_count" -eq 1 ]; then
    __print_heading "Linting \`$valid_file\`"
  else
    __print_heading "Linting $lint_label"
  fi

  for file in "$@"; do
    if [ ! -f "$file" ] || [ -L "$file" ]; then
      continue
    fi

    lint_file "$file"
  done
)

# Executes the given `domfiles` command in place. Optionally prints it with
# `--print`
__domfiles_exec() {
  __domfiles_exec_print_command=false

  if [ "${1-}" = '--print' ]; then
    __domfiles_exec_print_command=true
    shift
  fi

  if [ $# -eq 0 ]; then
    __print_error_and_exit '`__domfiles_exec` requires a command'
  fi

  __domfiles_exec_command="$1"
  shift

  if [ "$__domfiles_exec_print_command" = true ]; then
    __print_command domfiles "$__domfiles_exec_command" "$@"
  fi

  exec "$DOMFILES_BIN_DIR/domfiles-$__domfiles_exec_command" "$@"
}

# Returns success when `$1` is an available `domfiles` command
__domfiles_is_callable() {
  [ -x "$DOMFILES_BIN_DIR/domfiles-$1" ]
}

# Returns success when domfiles have no tracked changes
__domfiles_is_clean() {
  git -C "$DOMFILES" diff --quiet && git -C "$DOMFILES" diff --cached --quiet
}

# Prints executable files from the `bin` directory. Excludes symlinks and
# optionally filters with pattern `$1`
__domfiles_ls_bin() (
  if [ $# -gt 0 ]; then
    pattern="$1"
  else
    pattern='*'
  fi

  __domfiles_cd_bin
  set --
  __ifs_set

  # shellcheck disable=SC2086
  for file in $pattern; do
    if [ -f "$file" ] && [ ! -L "$file" ] && [ -x "$file" ]; then
      set -- "$@" "$file"
    fi
  done

  __ifs_restore
  [ $# -eq 0 ] || ls -- "$@"
)

# Runs `$1` in the caller’s directory, resolving it from the domfiles workspace
__domfiles_pnpm_exec() (
  if [ $# -eq 0 ]; then
    __print_error_and_exit '`__domfiles_pnpm_exec` requires a command'
  fi

  command="$1"
  shift

  pnpm --dir "$DOMFILES" exec sh -c '
    target="$(command -v "$2")" || exit
    cd "$1" || exit
    shift 2
    exec "$target" "$@"
  ' sh "$PWD" "$command" "$@"
)

# Prints the current domfiles revision
__domfiles_revision() {
  git -C "$DOMFILES" rev-parse HEAD
}

# Changes the current directory to the current repository root
__git_cd_root() {
  __domfiles_git_root="$(git rev-parse --show-toplevel)" || return $?

  cd "$__domfiles_git_root" \
    || __print_error_and_exit "Failed to change directory to \`$__domfiles_git_root\`"

  unset __domfiles_git_root
}

# Prints the default commit count. Excludes the initial commit with
# `--no-initial`
__git_default_commit_count() (
  default=10
  count=0

  if __git_is_commit_reference HEAD; then
    count="$(git rev-list --count HEAD)"
  fi

  if [ "${1-}" = '--no-initial' ] && [ "$count" -gt 0 ]; then
    count="$((count - 1))"
  fi

  printf '%s\n' "$((count < default ? count : default))"
)

# Prints exclusion parameters for the paths in `$@`
__git_diff_format_exclude_params() {
  if [ $# -eq 0 ]; then
    __print_error_and_exit '`__git_diff_format_exclude_params` requires at least one argument'
  fi

  printf '%s\n' "$@" \
    | while IFS= read -r path; do
      printf ':(exclude)%s\n' "$path"
    done
}

# Prints excluded paths changed in a given `--commit` or `--worktree`. Includes
# related manifests with `--related`
__git_diff_list_changed_excluded_paths() (
  if [ $# -eq 0 ]; then
    __print_error_and_exit '`__git_diff_list_changed_excluded_paths` requires at least one argument'
  fi

  mode="$1"
  shift

  if [ "$mode" = '--commit' ]; then
    if [ $# -eq 0 ]; then
      __print_error_and_exit '`__git_diff_list_changed_excluded_paths --commit` requires a reference'
    fi

    reference="$1"
    shift
  elif [ "$mode" != '--worktree' ]; then
    __print_error_and_exit '`__git_diff_list_changed_excluded_paths` received an invalid mode'
  fi

  files="$(__git_diff_list_excluded_files "$@")"
  __ifs_set

  # shellcheck disable=SC2086
  for file in $files; do
    if [ "$mode" = '--commit' ]; then
      if __git_is_path_changed_in_commit "$reference" "$file"; then
        printf '%s\n' "$file"
      else
        status="$?"
        [ "$status" -eq 1 ] || exit "$status"
      fi
    elif git diff-files --quiet -- "$file"; then
      continue
    else
      status="$?"

      if [ "$status" -eq 1 ]; then
        printf '%s\n' "$file"
      else
        exit "$status"
      fi
    fi
  done

  __ifs_restore
)

# Prints excluded lockfiles. Includes related manifests with `--related`
__git_diff_list_excluded_files() {
  if [ "${1-}" = '--related' ]; then
    printf '%s\n' 'Cargo.toml' 'package.json'
  fi

  printf '%s\n' 'Cargo.lock' 'package-lock.json' 'pnpm-lock.yaml' 'yarn.lock'
}

# Pages two sections for Git command `$1`. Adds a leading newline with
# `--leading-newline`
__git_diff_page() (
  leading_newline=false

  case "${1-}" in
    --leading-newline)
      leading_newline=true
      shift
      ;;
    --*)
      __print_error_and_exit '`__git_diff_page` received an invalid option'
      ;;
  esac

  if [ $# -ne 3 ]; then
    __print_error_and_exit \
      '`__git_diff_page` requires a Git command and two arguments after an optional `--leading-newline`'
  fi

  git_command="$1"
  shift

  {
    if [ "$leading_newline" = true ]; then
      echo
    fi

    printf '%s\n' "$1"
    echo
    printf '%s\n' "$2"
  } | __page_input "$git_command"
)

# Returns success when `$1` resolves to a commit
__git_is_commit_reference() {
  if git rev-parse --verify "$1^{commit}" > /dev/null 2>&1; then
    return 0
  else
    return 1
  fi
}

# Returns success when `$2` changed in commit `$1`
__git_is_path_changed_in_commit() (
  if [ $# -ne 2 ]; then
    __print_error_and_exit '`__git_is_path_changed_in_commit` requires two arguments'
  fi

  changed_files="$(git diff-tree --no-commit-id --name-only --root -m -r "$1" -- "$2")" \
    || return $?

  [ -n "$changed_files" ]
)

# Prints skipped files from the repository at `$1`. Applies any remaining
# arguments as filters relative to that location
__git_skipped_files() (
  if [ $# -eq 0 ]; then
    __print_error_and_exit '`__git_skipped_files` requires at least one argument'
  fi

  repository="$1"
  shift

  if [ $# -eq 0 ]; then
    repository="$(git -C "$repository" rev-parse --show-toplevel)" || return $?
  fi

  files="$(git -C "$repository" ls-files -v --full-name -- "$@")" || return $?
  printf '%s\n' "$files" | __grep '^[a-z]'
)

# Runs `grep` without failing on no matches
__grep() (
  if grep "$@"; then
    return 0
  else
    status="$?"
  fi

  [ "$status" -eq 1 ] && return 0
  return "$status"
)

# Restores the original `IFS`
__ifs_restore() {
  IFS="$DOMFILES_DEFAULT_IFS"
}

# Sets `IFS` to a newline
__ifs_set() {
  if [ "$IFS" != "$DOMFILES_DEFAULT_IFS" ]; then
    __print_error_and_exit '`IFS` is already being overridden'
  fi

  IFS='
'
}

# Returns success when `$1` is exactly `true` or `false`
__is_boolean() {
  if [ $# -ne 1 ]; then
    __print_error_and_exit '`__is_boolean` requires one value'
  fi

  [ "$1" = true ] || [ "$1" = false ]
}

# Returns success when Homebrew is installed. When `$1` is given, returns
# success when the package is installed through Homebrew
__is_brew_installed() {
  if [ $# -eq 0 ]; then
    (brew --version) > /dev/null 2>&1
  else
    brew list 2> /dev/null | grep -q "^$1\$"
  fi
}

# Returns success when `$1` is a keg-only Homebrew package
__is_brew_keg_only() {
  brew info "$1" --json=v2 2> /dev/null | grep -q '"keg_only": true'
}

# Returns success when `$1` is a linked Homebrew package
__is_brew_linked() {
  brew info "$1" --json=v2 2> /dev/null | grep -q '"linked_keg": "[^"]'
}

# Returns success when `$1` is available as a command
__is_callable() {
  sh -c 'command -v "$1"' sh "$1" > /dev/null 2>&1
}

# Returns success on CI
__is_ci() {
  [ -n "${CI-}" ] || [ -n "${GITHUB_ACTIONS-}" ]
}

# Returns success when Fish is the login shell
__is_fish() {
  __is_shell "$(brew --prefix)/bin/fish"
}

# Returns success when Fisher is installed
__is_fisher_installed() {
  fish --command 'fisher --version' > /dev/null 2>&1
}

# Returns success on macOS
__is_macos() {
  [ "$(uname -s)" = 'Darwin' ]
}

# Returns success when `$1` is the login shell
__is_shell() {
  [ "${1-}" = "$SHELL" ]
}

# Returns success when the SSH key pair is configured
__is_ssh_configured() {
  [ -s "$DOMFILES_SSH_KEY" ] && [ -s "$DOMFILES_SSH_KEY.pub" ]
}

# Returns success when standard input is a terminal
__is_stdin_tty() {
  [ -t 0 ]
}

# Returns success when standard output is a terminal
__is_stdout_tty() {
  [ -t 1 ]
}

# Returns success in an interactive terminal
__is_tty() {
  __is_stdin_tty && __is_stdout_tty
}

# Returns success when `$1` contains only decimal digits. Rejects values outside
# of the shell’s integer range
__is_uint() {
  case "$1" in
    '' | *[!0123456789]*)
      return 1
      ;;
    *)
      [ "$1" -ge 0 ] 2> /dev/null || return 1
      ;;
  esac
}

# Returns success when `vim-plug` is installed
__is_vim_plug_installed() {
  [ -s "$DOMFILES_VIM_PLUG" ] && grep -q '[^[:space:]]' "$DOMFILES_VIM_PLUG"
}

# Creates directory `$1` with standard permissions, creating any missing
# parents as needed
__mkdir() {
  __ mkdir -p "$1"
  __chmod "$1"
}

# Prints a normalized boolean. Returns failure when `$1` is unsupported
__normalize_boolean() {
  if [ $# -ne 1 ]; then
    __print_error '`__normalize_boolean` requires one value'
    return 1
  fi

  case "$1" in
    1 | [Tt][Rr][Uu][Ee] | [Oo][Nn] | [Yy][Ee][Ss])
      printf '%s\n' true
      ;;
    0 | [Ff][Aa][Ll][Ss][Ee] | [Oo][Ff][Ff] | [Nn][Oo])
      printf '%s\n' false
      ;;
    *)
      return 1
      ;;
  esac
}

# Pages standard input for terminal output or passes it through unchanged.
# Optionally uses Git pager configuration for command `$1`
__page_input() (
  if [ $# -gt 1 ]; then
    __print_error_and_exit '`__page_input` accepts at most one Git command'
  fi

  __is_stdout_tty || {
    cat
    return 0
  }

  pager="$(__resolve_pager "$@")"

  case "$pager" in
    cat | less)
      "$pager"
      ;;
    *)
      sh -c "$pager"
      ;;
  esac
)

# Prints `$@` as a shell-quoted command
__print_command() {
  if [ "$DOMFILES_SUPPRESSED" = true ] && ! __is_ci; then
    return 0
  fi

  __print_info "\$ $(__quote_params "$@")" >&2
}

# Prints the given text as a confirmation
__print_confirmation() {
  __print_info "✓ $*"
}

# Prints the given text as an error
__print_error() {
  __print_styled '0;31' '× %s\n' -- "$*" >&2
}

# Prints the given text as an error and exits
__print_error_and_exit() {
  __print_error "$*"
  exit 1
}

# Prints the given text as a heading
__print_heading() {
  __print_styled '1;33' '\n· %s\n' -- "$*"
}

# Prints the given text as a heading, dimmed
__print_heading_dimmed() {
  __print_styled '1;2' '\n· %s\n' -- "$*"
}

# Prints the given text as informational output. Accepts `--inline`
__print_info() {
  __print_styled 2 '%s\n' "$@"
}

# Prints the given text as informational output and exits
__print_info_and_exit() {
  __print_info -- "$*"
  exit 0
}

# Prints text with format `$2`. Applies style `$1` only to terminal
# output. Replaces `$HOME` with `~`. `--inline` uses a trailing space
# instead of a newline
__print_styled() (
  if [ $# -eq 0 ]; then
    return 0
  fi

  if [ $# -lt 2 ]; then
    __print_error '`__print_styled` requires a style and format'
    return 1
  fi

  style="$1"
  format="$2"
  shift 2

  if [ "${1-}" = '--inline' ]; then
    format="${format%'\n'} "
    shift
  fi

  if [ "${1-}" = '--' ]; then
    shift
  fi

  if [ -z "$format" ]; then
    return 0
  fi

  text="$(__string_replace "$*" "$HOME" '~')" || return $?

  if ! __is_stdout_tty; then
    style=''
  fi

  if [ -n "$style" ]; then
    printf '\033[%sm' "$style" || return $?
  fi

  # shellcheck disable=SC2059
  printf "$format" "$text" || return $?

  if [ -n "$style" ]; then
    printf '\033[0m'
  fi
)

# Prints the given text as a success
__print_success() {
  __print_styled '0;32' '✓ %s\n' -- "$*"
}

# Prints the given text as a URL
__print_url() {
  __print_info "↓ $*"
}

# Prints the given text as a warning. Accepts `--inline`
__print_warning() {
  __print_styled 1 '▴ %s\n' "$@"
}

# Prints parameters as shell-quoted values separated by spaces
__quote_params() {
  python3 -c '
import shlex, sys
params = (shlex.quote(param) for param in sys.argv[1:])
sys.stdout.write(" ".join(params))' "$@"
}

# Prints a normalized boolean from environment variable `$1`. Uses `$2` when
# unset or empty
__read_boolean_from_env() (
  if [ $# -ne 2 ]; then
    __print_error_and_exit '`__read_boolean_from_env` requires an environment variable name and boolean default'
  fi

  if ! __is_boolean "$2"; then
    __print_error_and_exit '`__read_boolean_from_env` requires a `true` or `false` default'
  fi

  # Preserve input whitespace with a marker before removing the `printenv` line ending
  value="$(
    printenv "$1" || true
    printf .
  )"
  value="${value%?}"
  value="${value%?}"

  if [ -z "$value" ]; then
    printf '%s\n' "$2"
    return 0
  fi

  if ! __normalize_boolean "$value"; then
    __print_error_and_exit "\`$1\` has an unsupported boolean value"
  fi
)

# Prints the pager command. Optionally uses Git configuration for command `$1`
__resolve_pager() (
  if [ $# -gt 1 ]; then
    __print_error_and_exit '`__resolve_pager` accepts at most one Git command'
  fi

  pager=''

  if [ $# -eq 1 ]; then
    if pager="$(git config --get "pager.$1")"; then
      case "$(git config --file /dev/null --type=bool --default "$pager" \
        --get domfiles.pager 2> /dev/null || true)" in
        false)
          pager='cat'
          ;;
        true)
          pager=''
          ;;
      esac
    fi
  fi

  if [ -n "$pager" ]; then
    printf '%s\n' "$pager"
  elif [ -n "${PAGER-}" ]; then
    printf '%s\n' "$PAGER"
  elif __is_callable less; then
    printf '%s\n' less
  else
    printf '%s\n' cat
  fi
)

# Runs `ssh-add` with `$@`
__ssh_add() {
  __print_command 'ssh-add' "$@"

  if ssh-add "$@" > /dev/null 2>&1; then
    return 0
  else
    __print_error 'Failed to add the SSH key'
    return 1
  fi
}

# Returns success when `$2` is a literal substring of `$1`
__string_contains() {
  case "$1" in
    *"$2"*)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

# Prints `$1` with every literal occurrence of `$2` replaced by `$3`
__string_replace() {
  if [ $# -ne 3 ]; then
    __print_error_and_exit '`__string_replace` requires three arguments'
  fi

  if [ -z "$2" ]; then
    __print_error_and_exit '`__string_replace` requires a nonempty pattern'
  fi

  if ! __string_contains "$1" "$2"; then
    printf '%s\n' "$1"
    return 0
  fi

  python3 -c '
import sys
subject, pattern, replacement = sys.argv[1:4]
sys.stdout.write(subject.replace(pattern, replacement))' "$@"
}

# Runs `$@`, suppressing `__print_command` output
__suppress() {
  if [ $# -eq 0 ]; then
    __print_error_and_exit '`__suppress` requires at least one argument'
  fi

  if [ "$1" = '__domfiles_exec' ]; then
    __print_error_and_exit '`__suppress` does not support `__domfiles_exec`'
  fi

  (
    export DOMFILES_SUPPRESSED=true
    "$@"
  )
}

# Replaces `$2` with a symlink to `$1`, creating any missing parents as needed
__symlink() (
  parent="$(dirname "$2")"

  if [ -d "$parent" ]; then
    source_path="$(realpath "$(dirname "$1")")/$(basename "$1")"
    destination_path="$(realpath "$parent")/$(basename "$2")"

    case "$source_path" in
      "$destination_path" | "$destination_path"/*)
        __print_error_and_exit "Symlink destination \`$destination_path\` contains source \`$source_path\`"
        ;;
    esac

    __suppress __ rm -rf "$2"
  else
    __mkdir "$parent"
  fi

  __ ln -s "$1" "$2"
)

# Prints how many leading lines from `$3` fit within `$2` rows at terminal
# width `$1`
__terminal_count_fitting_lines() (
  if [ $# -ne 3 ]; then
    __print_error_and_exit '`__terminal_count_fitting_lines` requires columns, available rows, and text'
  fi

  if ! __is_uint "$1" || [ "$1" -le 0 ]; then
    __print_error_and_exit '`__terminal_count_fitting_lines` requires a positive column count'
  fi

  if ! __is_uint "$2"; then
    __print_error_and_exit '`__terminal_count_fitting_lines` requires an unsigned available row count'
  fi

  columns="$1"
  available_rows="$2"

  printf '%s\n' "$3" \
    | {
      count=0
      used_rows=0

      while IFS= read -r line; do
        line_rows="$(__terminal_count_text_rows "$columns" "$line")"

        if [ "$((used_rows + line_rows))" -gt "$available_rows" ]; then
          break
        fi

        count="$((count + 1))"
        used_rows="$((used_rows + line_rows))"
      done

      printf '%s\n' "$count"
    }
)

# Prints the rows needed to render `$2` as plain text within terminal width `$1`
__terminal_count_text_rows() (
  if [ $# -ne 2 ]; then
    __print_error_and_exit '`__terminal_count_text_rows` requires columns and text'
  fi

  if ! __is_uint "$1" || [ "$1" -le 0 ]; then
    __print_error_and_exit '`__terminal_count_text_rows` requires a positive column count'
  fi

  columns="$1"
  rows="$(printf '%s\n' "$2" | expand | fold -w "$columns" | wc -l)"

  printf '%s\n' "$((rows))"
)

# Prints available rows and columns for the terminal on standard input.
# Optionally uses `$1` as the reserved row count
__terminal_get_available_size() (
  if [ $# -gt 1 ]; then
    __print_error_and_exit '`__terminal_get_available_size` accepts an optional reserved row count'
  fi

  reserved_rows="${1-4}"

  if ! __is_uint "$reserved_rows"; then
    __print_error_and_exit '`__terminal_get_available_size` requires an unsigned reserved row count'
  fi

  # Interpret leading-zero counts as decimal
  reserved_rows="${reserved_rows#"${reserved_rows%%[!0]*}"}"
  reserved_rows="${reserved_rows:-0}"

  size="$(stty size 2> /dev/null)" || return $?
  rows="${size%% *}"
  columns="${size##* }"

  if ! __is_uint "$rows" || [ "$rows" -le 0 ]; then
    return 1
  fi

  if ! __is_uint "$columns" || [ "$columns" -le 0 ]; then
    return 1
  fi

  available_rows="$((rows > reserved_rows ? rows - reserved_rows : 0))"
  printf '%s %s\n' "$available_rows" "$columns"
)

# Ensures file `$1` exists with standard permissions, creating any missing
# parents as needed
__touch() (
  parent="$(dirname "$1")"
  [ -d "$parent" ] || __mkdir "$parent"

  __ touch "$1"
  __chmod "$1"
)

# Runs `brew` with domfiles’ defaults
brew() (
  command='brew'

  if ! __is_callable "$command"; then
    command='/opt/homebrew/bin/brew'
    [ -x "$command" ] || __print_error_and_exit '`brew` is missing'
  fi

  HOMEBREW_NO_ASK=1 HOMEBREW_NO_AUTO_UPDATE=1 command "$command" "$@"
)

# Runs `pnpm` with domfiles’ defaults
pnpm() {
  if ! __is_callable pnpm; then
    __print_error_and_exit '`pnpm` is missing'
  fi

  PATH="$HOME/Library/pnpm/bin:$PATH" command pnpm "$@"
}

# Initialize helper variables
DOMFILES_DEFAULT_IFS="$IFS"
DOMFILES_SSH_KEY="$HOME/.ssh/id_ed25519"
DOMFILES_SUPPRESSED="$(__read_boolean_from_env DOMFILES_SUPPRESSED false)"
DOMFILES_VIM_PLUG="$HOME/.vim/autoload/plug.vim"
