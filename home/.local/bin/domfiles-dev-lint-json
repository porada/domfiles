#!/bin/sh

# shellcheck source=../share/domlib
. "$(dirname "$(realpath "$0")")/../share/domlib"

# Lint JSON files that come with domfiles
# (lints all files when no paths are provided)
__domfiles_cd_root

lint_default_files() {
  git ls-files --cached --others --exclude-standard -- '*.json'
}

lint_file() {
  __suppress __ jq --slurp \
    'if length == 1 then empty else error("expected exactly one JSON value, received \(length)") end' \
    -- "$1"
  __print_confirmation "$1"
}

__domfiles_dev_lint 'JSON files' "$@"
