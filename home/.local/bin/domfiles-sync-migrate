#!/bin/sh

# shellcheck source=../share/domlib
. "$(dirname "$(realpath "$0")")/../share/domlib"

# Migrate agent skills
outdated_agent_skills=false

for skill in \
  awesome-vitest-entry \
  claude-cli-subagent \
  claude-collaboration \
  commit \
  commit-flow \
  contribution-flow \
  diagnose \
  examine-workflow \
  git-worktrees \
  github-cli \
  harmonize \
  package-release-notes \
  prompt-relays \
  prose \
  release-notes \
  repository-harmonization \
  subagent-review \
  technical-copy \
  verify; do
  for path in "$HOME/.agents/skills/$skill" "$HOME/.claude/skills/$skill"; do
    if [ -L "$path" ]; then
      if [ "$outdated_agent_skills" = false ]; then
        __print_heading_dimmed 'Cleaning up outdated agent skills'
        outdated_agent_skills=true
      fi

      __ rm -f "$path"
    fi
  done
done

# Uninstall `node@24`
if __is_brew_installed node@24; then
  __print_heading_dimmed 'Uninstalling `node@24`'
  __ brew uninstall node@24
fi
