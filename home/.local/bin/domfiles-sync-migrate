#!/bin/sh

# shellcheck source=../share/domlib
. "$(dirname "$(realpath "$0")")/../share/domlib"

# Migrate agent instructions
outdated_agent_instructions=false

for skill in \
  awesome-vitest-entry \
  claude-cli-subagent \
  claude-collaboration \
  commit \
  commit-flow \
  contribution-flow \
  git-worktrees \
  github-cli \
  harmonize \
  package-release-notes \
  prompt-relays \
  prose \
  release-notes \
  repository-harmonization \
  technical-copy \
  verify; do
  for path in "$HOME/.agents/skills/$skill" "$HOME/.claude/skills/$skill"; do
    if [ -L "$path" ]; then
      if [ "$outdated_agent_instructions" = false ]; then
        __print_heading_dimmed 'Cleaning up outdated agent instructions'
        outdated_agent_instructions=true
      fi

      __ rm -f "$path"
    fi
  done
done

# Remove legacy `pnpm` store config
if __is_callable node && __is_callable pnpm; then
  if [ "$(pnpm config get --global store-dir)" = "$HOME/Library/pnpm/store" ]; then
    __print_heading_dimmed 'Removing legacy `pnpm` store config'
    __ pnpm config delete --global store-dir
  fi
fi

# Rename Standard Config projects
renamed_projects=false

for project in "$DOMFILES_PROJECTS_DIR"/sc-*; do
  [ -d "$project" ] || continue

  name="${project##*/}"
  destination="$DOMFILES_PROJECTS_DIR/standard-config-${name#sc-}"

  if [ -e "$destination" ] || [ -L "$destination" ]; then
    continue
  fi

  if [ "$renamed_projects" = false ]; then
    __print_heading_dimmed 'Renaming Standard Config projects'
    renamed_projects=true
  fi

  __ mv "$project" "$destination"
done

# Uninstall Cargo-related tooling
cargo_packages=false

for package in cargo-edit taplo tombi; do
  if __is_brew_installed "$package"; then
    if [ "$cargo_packages" = false ]; then
      __print_heading_dimmed 'Uninstalling Cargo-related tooling'
      cargo_packages=true
    fi

    __ brew uninstall "$package"
  fi
done
