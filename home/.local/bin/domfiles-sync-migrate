#!/bin/sh

# shellcheck source=../share/domlib
. "$(dirname "$(realpath "$0")")/../share/domlib"

# Migrate agent skills
outdated_agent_skills=false

for skill in \
  awesome-vitest-entry \
  claude-cli-subagent \
  claude-collaboration \
  cli-subagent \
  commit \
  commit-flow \
  contribution-flow \
  diagnose \
  examine-workflow \
  full-review \
  git-worktrees \
  github-cli \
  harmonize \
  package-release-notes \
  prompt-relays \
  prose \
  release-notes \
  repository-harmonization \
  subagent-review \
  technical-copy \
  verify; do
  for path in "$HOME/.agents/skills/$skill" "$HOME/.claude/skills/$skill"; do
    if [ -L "$path" ]; then
      if [ "$outdated_agent_skills" = false ]; then
        __print_heading_dimmed 'Cleaning up outdated agent skills'
        outdated_agent_skills=true
      fi

      __ rm -f "$path"
    fi
  done
done

# Uninstall legacy commands
for formula in ast-grep node@24; do
  if __is_brew_installed "$formula"; then
    __print_heading_dimmed "Uninstalling \`$formula\`"
    __ brew uninstall "$formula"
  fi
done

# Uninstall commands that aren’t used on Linux
if ! __is_macos; then
  for formula in just rust; do
    if __is_brew_installed "$formula"; then
      __print_heading_dimmed "Uninstalling \`$formula\`"
      __ brew uninstall "$formula"
    fi
  done
fi
