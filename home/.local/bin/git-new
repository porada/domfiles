#!/bin/sh

# shellcheck source=../share/domlib
. "$(dirname "$(realpath "$0")")/../share/domlib"

# Create a new branch, overwriting it if necessary
if [ $# -ne 1 ]; then
  __print_error_and_exit '`git new` requires one argument'
fi

branch="$(git check-ref-format --branch "$1")" || exit $?

if git show-ref --verify --quiet "refs/heads/$branch"; then
  if ! __confirm "Overwrite branch \`$branch\`?"; then
    exit 0
  fi
else
  status="$?"
  [ "$status" -eq 1 ] || exit "$status"
fi

__ git checkout -B "$branch"
