#!/bin/sh

# shellcheck source=../share/domlib
. "$(dirname "$(realpath "$0")")/../share/domlib"

__print_heading 'Installing dependencies'
__is_ci && __ brew --version
__ brew analytics off

__print_heading_dimmed 'Ensuring `brew` is up to date'
__ brew update --quiet

if __is_ci; then
  __ brew --version
else
  __ brew upgrade --overwrite || true
fi

install() (
  if ! __is_brew_installed "$1"; then
    __print_heading "Installing \`$1\`"
    __ brew install --quiet "$@"
  fi

  # Cask-installed apps don’t need any additional treatment
  for param; do
    if [ "$param" = '--cask' ]; then
      return
    fi
  done

  formula_info="$(brew info "$1" --json=v2)" || return

  # Treat only an explicit `false` receipt flag as needing protection
  # from `brew autoremove`
  formula_is_requested="$(printf '%s\n' "$formula_info" \
    | jq 'all(.formulae[0].installed[]?; .installed_on_request != false)')" || return

  if [ "$formula_is_requested" = false ] && ! __is_ci; then
    __print_heading_dimmed "Marking \`$1\` as installed on request"
    __ brew tab --formula --installed-on-request "$1" > /dev/null
  fi

  # Ensure keg-only formulas are linked
  formula_is_keg_only="$(printf '%s\n' "$formula_info" \
    | jq '.formulae[0].keg_only == true')" || return

  formula_is_linked="$(printf '%s\n' "$formula_info" \
    | jq '(.formulae[0].linked_keg // "") != ""')" || return

  if [ "$formula_is_keg_only" = true ] && [ "$formula_is_linked" = false ]; then
    __print_heading_dimmed "Linking \`$1\`"
    __ brew link --quiet --overwrite --force "$1"
  fi
)

# Install primary dependencies
for formula in fish fisher git node pnpm; do
  install "$formula"
done

# Install macOS apps
if __is_macos && ! __is_ci; then
  install mole
  install zed --adopt --cask
fi

# Install development dependencies
if ! __is_ci; then
  for formula in actionlint fd gh jq just pandoc ripgrep rust shellcheck vim yarn yq zizmor; do
    install "$formula"
  done

  for formula in claude-code codex; do
    install "$formula" --cask
  done
fi

# Clean up `brew`
if ! __is_ci; then
  __ brew cleanup --prune=all > /dev/null
fi

# Link Homebrew-installed tools
if __is_callable git; then
  __print_heading_dimmed 'Linking Homebrew-installed tools'
  __symlink \
    "$(brew --prefix git)/share/git-core/contrib/diff-highlight/diff-highlight" \
    "$HOME/.local/bin/git-diff-highlight"
fi

# Configure `pnpm`
if __is_callable node && __is_callable pnpm; then
  __print_heading_dimmed 'Configuring `pnpm`'

  # Install `pnpm` completions
  if __is_callable fish; then
    __mkdir "$DOMFILES_CONFIG_DIR/fish/completions"
    __ fish --command 'pnpm completion fish > "$argv"' -- "$DOMFILES_CONFIG_DIR/fish/completions/pnpm.fish"
  fi

  # Exclude `pnpm` directories from Time Machine backups
  if __is_macos; then
    __ pnpm config set --global macosBackup --json '{
  "excludeModulesDir": true,
  "excludeStoreDir": true
}'
  fi

  # Install project dependencies
  __print_heading_dimmed 'Installing `pnpm` dependencies'

  if __domfiles_is_clean; then
    __ pnpm --dir "$DOMFILES" --loglevel=error install --frozen-lockfile
  else
    __print_warning 'The repository contains uncommitted changes. Skipping `pnpm install`'
  fi
fi

# Install `vim-plug`
if __is_callable vim && ! __is_vim_plug_installed && ! __is_ci; then
  __print_heading 'Installing `vim-plug`'

  url='https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim'
  __print_url "$url"

  __suppress __ curl --fail --location --remove-on-error "$url" --output "$DOMFILES_VIM_PLUG" --create-dirs

  if ! __is_vim_plug_installed; then
    __print_error_and_exit 'Failed to install `vim-plug`'
  fi

  __print_confirmation "$DOMFILES_VIM_PLUG"
fi

# Install Xcode components
if __is_macos && __is_xcode_installed && ! __is_ci; then
  __print_heading_dimmed 'Installing Xcode components'

  if xcrun --sdk macosx metal --version > /dev/null 2>&1; then
    __print_confirmation 'Metal Toolchain'
  elif __ xcodebuild -downloadComponent MetalToolchain; then
    if __ xcrun --sdk macosx metal --version; then
      __print_confirmation 'Metal Toolchain'
    else
      __print_error 'Failed to verify the Metal Toolchain after downloading'
    fi
  else
    __print_error 'Failed to download the Metal Toolchain'
  fi
fi

# Set `fish` as the default shell
fish="$(brew --prefix)/bin/fish"

if [ "$(__login_shell)" = "$fish" ] || __is_ci; then
  exit
fi

if ! __is_stdin_tty; then
  __print_warning 'Setting `fish` as the default shell requires an interactive terminal'
  exit
fi

if ! grep -qFx -- "$fish" /etc/shells; then
  __print_heading 'Adding `fish` to `/etc/shells`'
  __ sudo sh -c 'printf "%s\n" "$1" >> /etc/shells' sh "$fish" || true
fi

__print_heading_dimmed 'Setting `fish` as the default shell'

if __ chsh -s "$fish"; then
  __print_confirmation "$fish"
else
  __print_error_and_exit "Failed to set \`$fish\` as the default shell"
fi
