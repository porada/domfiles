#!/bin/sh

# shellcheck source=../share/domlib
. "$(dirname "$(realpath "$0")")/../share/domlib"

# Show formatted `git diff` output
if [ $# -eq 0 ]; then
  __git_cd_root
  excluded_paths="$(__git_diff_list_changed_excluded_paths --worktree)"

  if [ -n "$excluded_paths" ]; then
    color_mode=never
    __is_stdout_tty && color_mode=always
    exclude_params="$(__git_diff_format_exclude_params "$excluded_paths")"
    excluded_paths="$(__git_diff_list_changed_excluded_paths --worktree --related)"

    # shellcheck disable=SC2086
    if git diff --quiet -- . $exclude_params; then
      git diff -- $excluded_paths
      exit $?
    else
      status="$?"
      [ "$status" -eq 1 ] || exit "$status"
    fi

    # shellcheck disable=SC2086
    stat_output="$(git diff --stat --color="$color_mode" -- $excluded_paths)" || exit $?
    # shellcheck disable=SC2086
    patch_output="$(git diff --patch --color="$color_mode" -- . $exclude_params)" || exit $?

    __git_diff_page --leading-newline diff "$stat_output" "$patch_output"
    exit $?
  fi
fi

git diff "$@"
