#!/bin/sh

# shellcheck source=../share/domlib
. "$(dirname "$(realpath "$0")")/../share/domlib"

# Show formatted `git diff` output
if [ $# -eq 0 ]; then
  __git_cd_root

  if __git_diff_with_excluded_paths git diff --quiet; then
    has_lockfile_changes=false
  else
    status="$?"
    [ "$status" -eq 1 ] || exit "$status"
    has_lockfile_changes=true
  fi

  if [ "$has_lockfile_changes" = true ]; then
    color_mode=never
    __is_stdout_tty && color_mode=always

    if __git_diff_with_excluded_paths --others git diff --quiet; then
      __git_diff_with_excluded_paths --related git diff
      exit
    else
      status="$?"
      [ "$status" -eq 1 ] || exit "$status"
    fi

    stat_output="$(__git_diff_with_excluded_paths --related git diff --stat --color="$color_mode")" \
      || exit
    patch_output="$(__git_diff_with_excluded_paths --others git diff --patch --color="$color_mode")" \
      || exit

    __git_diff_page --leading-newline diff "$stat_output" "$patch_output"
    exit
  fi
fi

git diff "$@"
