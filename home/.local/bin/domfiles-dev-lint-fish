#!/bin/sh

# shellcheck source=../share/domlib
. "$(dirname "$(realpath "$0")")/../share/domlib"

# Lint Fish shell scripts that come with domfiles
# (lints all files when no paths are provided)
__domfiles_cd_root

lint_default_files() {
  git ls-files --cached --others --exclude-standard -- '*.fish'
}

lint_file() {
  __ fish --no-execute -- "$1"
}

__domfiles_dev_lint 'Fish scripts' "$@"
