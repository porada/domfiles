#!/bin/sh

# shellcheck source=../share/domlib
. "$(dirname "$(realpath "$0")")/../share/domlib"

__print_heading 'Linking domfiles'

for source in .config .curlrc .local/bin .vimrc; do
  __symlink "$DOMFILES_HOME_DIR/$source" "$HOME/$source"
done

__print_heading_dimmed 'Linking agent instructions'

__symlink "$DOMFILES/.agents/GLOBAL.md" "$HOME/.claude/CLAUDE.md"
__symlink "$DOMFILES/.agents/GLOBAL.md" "$HOME/.codex/AGENTS.md"

__print_heading_dimmed 'Linking agent skills'

for source in .domfiles-agent-documentation .domfiles-commit .domfiles-contribution-flow \
  .domfiles-git-worktrees .domfiles-harmonize .domfiles-release-notes .domfiles-verify \
  agent-task-relay fish-shell-scripting human-facing-writing posix-shell-scripting \
  release-notes-for-humans simple-github-cli; do
  name="$(__string_replace "$source" '.domfiles-' '')"
  path="$DOMFILES/skills/$source"

  __suppress __symlink "$path" "$HOME/.agents/skills/$name"
  __suppress __symlink "$path" "$HOME/.claude/skills/$name"
  __print_confirmation "$source"
done

__print_heading_dimmed 'Provisioning additional files'

__mkdir "$DOMFILES_PROJECTS_DIR"
__touch "$DOMFILES_CONFIG_DIR/fish/local.fish"
__touch "$DOMFILES_CONFIG_DIR/git/allowed_signers"
__touch "$DOMFILES_CONFIG_DIR/npm/user.npmrc"
__touch "$HOME/.hushlogin"

__print_heading_dimmed 'Ensuring proper permissions'

__chmod "$DOMFILES"
__chmod "$HOME/.ssh"

__print_heading_dimmed 'Verifying SSH setup'

if ! __is_ssh_configured; then
  __print_error "SSH setup requires a complete key pair at \`$DOMFILES_SSH_KEY\`"
else
  __print_confirmation "$DOMFILES_SSH_KEY"

  # Set up allowed signers for `git`
  signer="$(git config --global --get user.email 2> /dev/null || true)"

  if [ -z "$signer" ]; then
    __print_error_and_exit 'Failed to resolve `user.email` from `git config`'
  fi

  key=''
  type=''
  read -r type key _ < "$DOMFILES_SSH_KEY.pub" || true

  if [ -z "$key" ] || [ -z "$type" ]; then
    __print_error_and_exit "Failed to parse the public key at \`$DOMFILES_SSH_KEY.pub\`"
  fi

  printf '%s namespaces="git" %s %s\n' "$signer" "$type" "$key" \
    > "$DOMFILES_CONFIG_DIR/git/allowed_signers"

  __print_confirmation "$DOMFILES_CONFIG_DIR/git/allowed_signers"
fi
