#!/bin/sh

# shellcheck source=../share/domlib
. "$(dirname "$(realpath "$0")")/../share/domlib"
# shellcheck source=../share/domfiles/sync/repository
. "$DOMFILES_BIN_DIR/../share/domfiles/sync/repository"

# Accept `--core`, `--help`, or one optional stage name and reject other
# arguments before any changes
core=false
stage=''
usage='Usage: domfiles sync [--core | --help | clean | install | macos | migrate | setup | update]'

case "$#:${1-}" in
  0:) ;;
  1:--core)
    core=true
    ;;
  1:--help)
    printf '%s\n' "$usage" '' \
      '`domfiles sync` runs all stages.' \
      '' \
      '`domfiles sync --core` refreshes links and installs missing packages.' \
      '' \
      'Both commands check for repository updates only when the checkout is on `master`.' \
      '' \
      '`domfiles sync <stage>` runs one stage without updating the repository.'
    exit
    ;;
  1:clean | 1:install | 1:macos | 1:migrate | 1:setup | 1:update)
    stage="$1"
    ;;
  *)
    __print_error_and_exit "$usage"
    ;;
esac

# shellcheck disable=SC2119
if ! __is_brew_installed; then
  __print_error_and_exit '`brew` needs to be installed before running `domfiles sync`'
fi

__print_heading "Syncing domfiles on $(__pretty_hostname)"

# Update the repository for a full or core sync. A named stage uses the
# current checkout
if [ -z "$stage" ] && can_update_repository; then
  revision="$(__domfiles_revision)"
  update_repository

  # Restart with the original arguments so the updated sync runs
  if [ "$(__domfiles_revision)" != "$revision" ]; then
    __print_heading_dimmed 'Restarting the sync after the update'
    __domfiles_exec --print sync "$@"
  fi
fi

# Update first so upstream can repair a local stage that fails to parse
# shellcheck source=../share/domfiles/sync/clean
. "$DOMFILES_BIN_DIR/../share/domfiles/sync/clean"
# shellcheck source=../share/domfiles/sync/core
. "$DOMFILES_BIN_DIR/../share/domfiles/sync/core"
# shellcheck source=../share/domfiles/sync/install
. "$DOMFILES_BIN_DIR/../share/domfiles/sync/install"
# shellcheck source=../share/domfiles/sync/macos
. "$DOMFILES_BIN_DIR/../share/domfiles/sync/macos"
# shellcheck source=../share/domfiles/sync/migrate
. "$DOMFILES_BIN_DIR/../share/domfiles/sync/migrate"
# shellcheck source=../share/domfiles/sync/setup
. "$DOMFILES_BIN_DIR/../share/domfiles/sync/setup"
# shellcheck source=../share/domfiles/sync/update
. "$DOMFILES_BIN_DIR/../share/domfiles/sync/update"

# Run stages as plain commands to keep strict mode active within them
if [ "$core" = true ]; then
  sync_core
  exit
fi

if [ -n "$stage" ]; then
  "sync_$stage"
  exit
fi

sync_migrate
sync_setup
sync_install
sync_macos
sync_update
sync_clean

# Finish with dependency status
__print_heading 'Sync complete'
__domfiles dependencies || true
__is_shell fish || echo
