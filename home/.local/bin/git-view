#!/bin/sh

# shellcheck source=../share/domlib
. "$(dirname "$(realpath "$0")")/../share/domlib"

# Show formatted `git show` output
if [ $# -eq 0 ]; then
  set -- HEAD
fi

if [ $# -eq 1 ] && __git_is_commit_reference "$1"; then
  __git_cd_root

  # Use changed names because `--quiet` with `-m` can miss merge changes
  changed_lockfiles="$(__git_diff_with_excluded_paths \
    git diff-tree --no-commit-id --name-only --root -m -r "$1")"
  has_lockfile_changes=false
  [ -z "$changed_lockfiles" ] || has_lockfile_changes=true

  if [ "$has_lockfile_changes" = true ]; then
    if __git_is_commit_reference "$1^2"; then
      # Preserve Git’s parent-qualified merge sections instead of splitting lockfile output
      git show --show-signature -m "$1"
      exit
    fi

    color_mode=never
    __is_stdout_tty && color_mode=always

    if __git_diff_with_excluded_paths --others git diff-tree --quiet --root "$1" > /dev/null; then
      __git_diff_with_excluded_paths --related git show --show-signature "$1"
      exit
    else
      status="$?"
      [ "$status" -eq 1 ] || exit "$status"
    fi

    stat_output="$(__git_diff_with_excluded_paths --related \
      git show --show-signature --stat --color="$color_mode" "$1")" || exit

    patch_output="$(__git_diff_with_excluded_paths --others \
      git show --pretty=format: --color="$color_mode" "$1^{commit}")" || exit

    __git_diff_page show "$stat_output" "$patch_output"
    exit
  fi
fi

git show --show-signature "$@"
