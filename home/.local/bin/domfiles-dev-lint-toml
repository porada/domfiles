#!/bin/sh

# shellcheck source=../share/domlib
. "$(dirname "$(realpath "$0")")/../share/domlib"

# Lint TOML files that come with domfiles
# (lints all files when no paths are provided)
__domfiles_cd_root

lint_default_files() {
  git ls-files --cached --others --exclude-standard -- '*.toml'
}

lint_files() {
  __ tombi lint --offline -- "$@"
}

__domfiles_dev_lint 'TOML files' "$@"
