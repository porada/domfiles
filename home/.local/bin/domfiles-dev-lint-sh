#!/bin/sh

# shellcheck source=../share/domlib
. "$(dirname "$(realpath "$0")")/../share/domlib"

# Lint selected POSIX shell scripts or all project shell scripts by default
__domfiles_cd_root

lint_default_files() {
  git ls-files --cached --others --exclude-standard -- \
    '*.sh' \
    'home/.local/bin/*' \
    'home/.local/share/*'
}

lint_files() {
  __ shellcheck --external-sources -- "$@"
}

__domfiles_dev_lint 'POSIX shell scripts' "$@"
