{
	"agent_buffer_font_size": 13,
	"agent_servers": {
		"claude-acp": {
			"default_config_options": {
				"model": "opus",
				"effort": "xhigh",
				"mode": "auto"
			},
			"type": "registry"
		}
	},
	"autosave": "on_focus_change",
	"buffer_font_features": {
		"calt": false
	},
	"buffer_font_size": 14,
	"cli_default_open_behavior": "existing_window",
	"collaboration_panel": {
		"button": false
	},
	"context_servers": {
		"grep": {
			"url": "https://mcp.grep.app"
		}
	},
	"debugger": {
		"button": false
	},
	"diagnostics": {
		"button": false
	},
	"diff_view_style": "unified",
	"file_types": {
		"Plain Text": [
			"TODO"
		]
	},
	"git": {
		"inline_blame": {
			"enabled": false
		},
		"worktree_directory": "../.zed"
	},
	"git_panel": {
		"dock": "left"
	},
	"gutter": {
		"runnables": false
	},
	"hard_tabs": true,
	"inline_code_actions": false,
	"language_servers": [
		"!eslint",
		"!rust-analyzer",
		"!tailwindcss-language-server",
		"..."
	],
	"languages": {
		"Editorconfig": {
			"soft_wrap": "none"
		},
		"JSON": {
			"tab_size": 4
		},
		"JavaScript": {
			"language_servers": [
				"typescript-ls",
				"!vtsls"
			]
		},
		"Plain Text": {
			"format_on_save": "off",
			"show_edit_predictions": false,
			"soft_wrap": "editor_width"
		},
		"TSX": {
			"language_servers": [
				"typescript-ls",
				"!vtsls"
			]
		},
		"TypeScript": {
			"language_servers": [
				"typescript-ls",
				"!vtsls"
			]
		}
	},
	"outline_panel": {
		"dock": "left"
	},
	"project_panel": {
		"dock": "left",
		"hide_root": true,
		"show_diagnostics": "off"
	},
	"read_only_files": [
		"**/*.snap",
		"**/*.tsbuildinfo",
		"**/.next/**",
		"**/.pnpm-store/**",
		"**/build/**",
		"**/Cargo.lock",
		"**/coverage/**",
		"**/dist/**",
		"**/fish_variables",
		"**/next-env.d.ts",
		"**/node_modules/**",
		"**/package-lock.json",
		"**/pnpm-lock.yaml",
		"**/skills-lock.json",
		"**/target/**",
		"**/yarn.lock"
	],
	"scrollbar": {
		"cursors": false,
		"diagnostics": "none",
		"selected_symbol": false,
		"selected_text": false
	},
	"search": {
		"button": false
	},
	"show_whitespaces": "boundary",
	"ssh_connections": [
		{
			"host": "homeassistant.local",
			"nickname": "Home Assistant",
			"projects": [
				{
					"paths": [
						"/homeassistant"
					]
				}
			],
			"username": "root"
		}
	],
	"tab_bar": {
		"show_tab_bar_buttons": false
	},
	"tabs": {
		"git_status": true
	},
	"telemetry": {
		"diagnostics": false,
		"metrics": false
	},
	"terminal": {
		"button": false,
		"line_height": {
			"custom": 1.35
		},
		"scrollbar": {
			"show": "never"
		}
	},
	"theme": "One Dark",
	"title_bar": {
		"show_user_picture": false
	},
	"toolbar": {
		"quick_actions": false
	},
	"ui_font_family": ".SystemUIFont",
	"ui_font_size": 15,
	"whitespace_map": {
		"tab": " "
	},
	"wrap_guides": [
		80,
		100
	],
	"agent": {
		"default_model": {
			"model": "gpt-6-astra",
			"provider": "openai-subscribed",
			"effort": "xhigh",
			"enable_thinking": true
		},
		"default_width": 600,
		"dock": "right",
		"enable_feedback": false,
		"expand_terminal_card": false,
		"favorite_models": [
			{
				"model": "claude-opus-5-5",
				"provider": "anthropic",
				"effort": "high",
				"enable_thinking": true
			},
			{
				"model": "gpt-6-astra",
				"provider": "openai-subscribed",
				"effort": "xhigh",
				"enable_thinking": true
			},
			{
				"model": "gpt-6.1-sol",
				"provider": "openai-subscribed",
				"effort": "xhigh",
				"enable_thinking": true
			},
			{
				"model": "gpt-daybreak-blue-latest",
				"provider": "openai-subscribed",
				"effort": "xhigh",
				"enable_thinking": true
			}
		],
		"flexible": false,
		"limit_content_width": false,
		"sandbox_permissions": {
			"allow_all_hosts": true,
			"write_paths": [
				"/private/tmp",
				"/Users/dom/.agents",
				"/Users/dom/.cache",
				"/Users/dom/.cargo",
				"/Users/dom/.claude",
				"/Users/dom/.claude.json",
				"/Users/dom/.codex",
				"/Users/dom/.npm",
				"/Users/dom/.yarn",
				"/Users/dom/.yarnrc",
				"/Users/dom/Library/Caches/Codex",
				"/Users/dom/Library/Caches/Homebrew",
				"/Users/dom/Library/Caches/pnpm",
				"/Users/dom/Library/Caches/typescript",
				"/Users/dom/Library/Caches/Yarn",
				"/Users/dom/Library/Caches/Zed",
				"/Users/dom/Library/pnpm",
				"/Users/dom/Projects"
			]
		},
		"show_merge_conflict_indicator": false,
		"threads_sidebar": {
			"auto_open": true,
			"default_width": 200,
			"position": "right"
		},
		"tool_permissions": {
			"default": "allow",
			"tools": {
				"fetch": {
					"default": "deny",
					"always_allow": [
						{
							"pattern": "^(?i:https://(?:[^./?#:@]+\\.)*[^./?#:@]+)(?:[/?#]|$)",
							"case_sensitive": true
						}
					]
				}
			}
		}
	}
}
