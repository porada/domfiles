{
	"agent_buffer_font_size": 13,
	"agent_servers": {
		"claude-acp": {
			"default_config_options": {
				"effort": "max",
				"mode": "auto",
				"model": "opus"
			},
			"type": "registry"
		}
	},
	"autosave": "on_focus_change",
	"buffer_font_features": {
		"calt": false
	},
	"buffer_font_size": 14,
	"cli_default_open_behavior": "new_window",
	"collaboration_panel": {
		"button": false
	},
	"context_servers": {
		"grep": {
			"url": "https://mcp.grep.app"
		}
	},
	"debugger": {
		"button": false
	},
	"diff_view_style": "unified",
	"file_types": {
		"Plain Text": [
			"TODO"
		]
	},
	"git": {
		"inline_blame": {
			"enabled": false
		},
		"worktree_directory": "../.zed"
	},
	"git_panel": {
		"dock": "left"
	},
	"gutter": {
		"runnables": false
	},
	"hard_tabs": true,
	"inline_code_actions": false,
	"language_servers": [
		"!eslint",
		"!tailwindcss-language-server",
		"..."
	],
	"languages": {
		"JavaScript": {
			"language_servers": [
				"typescript-ls",
				"!vtsls"
			]
		},
		"Plain Text": {
			"format_on_save": "off",
			"show_edit_predictions": false,
			"soft_wrap": "editor_width"
		},
		"TSX": {
			"language_servers": [
				"typescript-ls",
				"!vtsls"
			]
		},
		"TypeScript": {
			"language_servers": [
				"typescript-ls",
				"!vtsls"
			]
		}
	},
	"outline_panel": {
		"dock": "left"
	},
	"project_panel": {
		"dock": "left",
		"hide_root": true
	},
	"restore_on_startup": "last_workspace",
	"scrollbar": {
		"cursors": false,
		"selected_symbol": false,
		"selected_text": false
	},
	"search": {
		"button": false
	},
	"show_whitespaces": "boundary",
	"tabs": {
		"git_status": true
	},
	"telemetry": {
		"diagnostics": false,
		"metrics": false
	},
	"terminal": {
		"button": false,
		"line_height": {
			"custom": 1.35
		},
		"scrollbar": {
			"show": "never"
		}
	},
	"theme": "One Dark",
	"title_bar": {
		"show_user_picture": false
	},
	"toolbar": {
		"quick_actions": false
	},
	"ui_font_family": ".SystemUIFont",
	"ui_font_size": 15,
	"whitespace_map": {
		"tab": " "
	},
	"wrap_guides": [
		80,
		100
	],
	"agent": {
		"auto_compact": {
			"threshold": "85%"
		},
		"default_model": {
			"effort": "max",
			"enable_thinking": true,
			"model": "gpt-6-astra",
			"provider": "openai-subscribed"
		},
		"default_width": 600,
		"dock": "right",
		"enable_feedback": false,
		"expand_terminal_card": false,
		"flexible": false,
		"limit_content_width": false,
		"sandbox_permissions": {
			"network_hosts": [
				"*.spec.whatwg.org",
				"add-skill.vercel.sh",
				"agentclientprotocol.com",
				"agents.md",
				"agentskills.io",
				"alerts.home-assistant.io",
