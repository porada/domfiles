		"show_merge_conflict_indicator": false,
		"sidebar_side": "right",
		"tool_permissions": {
			"default": "allow",
			"tools": {
				"fetch": {
					"default": "confirm",
					"always_allow": [
						{
							"pattern": "^(?i:https://(?:[^./?#:@]+\\.)*[^./?#:@]+)(?:[/?#]|$)",
							"case_sensitive": true
						}
					],
					"always_confirm": [
						{
							"pattern": "^(?i:https://keith\\.github\\.io)(?:[?#]|$|/(?:$|[^x]|x(?:$|[^c])|xc(?:$|[^o])|xco(?:$|[^d])|xcod(?:$|[^e])|xcode(?:$|[^-])|xcode-(?:$|[^m])|xcode-m(?:$|[^a])|xcode-ma(?:$|[^n])|xcode-man(?:$|[^-])|xcode-man-(?:$|[^p])|xcode-man-p(?:$|[^a])|xcode-man-pa(?:$|[^g])|xcode-man-pag(?:$|[^e])|xcode-man-page(?:$|[^s])|xcode-man-pages(?:$|[^/])))",
							"case_sensitive": true
						}
					]
				}
			}
		}
	}
