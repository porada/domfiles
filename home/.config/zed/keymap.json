[
	{
		"bindings": {
			"cmd-shift-n": "agent::NewThread"
		}
	},
	{
		"context": "!FileFinder && !GitBranchSelector",
		"bindings": {
			"cmd-shift-i": "agent::Toggle"
		}
	},
	{
		"context": "!ProjectSearchBar && !ProjectSearchView",
		"bindings": {
			"cmd-shift-j": "multi_workspace::ToggleWorkspaceSidebar"
		}
	},
	{
		"context": "Editor",
		"bindings": {
			"cmd-shift-d": "editor::DuplicateLineDown",
			"cmd-shift-o": "editor::SortLinesCaseInsensitive"
		}
	},
	{
		"context": "!AcpThread > (Editor && mode == full)",
		"bindings": {
			"ctrl-enter": [
				"workspace::SendKeystrokes",
				"cmd-? cmd-n cmd-? cmd->"
			]
		}
	},
	{
		"context": "Terminal",
		"bindings": {
			"cmd-t": "workspace::NewTerminal"
		}
	},
	{
		"context": "Workspace",
		"bindings": {
			"cmd-shift-d": null
		}
	}
]
