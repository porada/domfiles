{
	"file_scan_exclusions": [
		".claude/skills",
		".config/zed/prompts",
		"bin/git-diff-highlight",
		"..."
	],
	"format_on_save": "on",
	"formatter": [
		{
			"external": {
				"command": "node_modules/.bin/prettier",
				"arguments": [
					"--ignore-unknown",
					"--stdin-filepath",
					"{buffer_path}"
				]
			}
		}
	],
	"languages": {
		"Rust": {
			"enable_language_server": false
		}
	}
}
