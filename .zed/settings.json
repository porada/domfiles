{
	"file_scan_exclusions": [
		".config/zed/prompts",
		".DS_Store",
		".git",
		"bin/git-diff-highlight"
	],
	"file_types": {
		"Git Ignore": [
			".config/git/global_ignores"
		]
	},
	"format_on_save": "on",
	"formatter": [
		{
			"external": {
				"command": "node_modules/.bin/prettier",
				"arguments": [
					"--ignore-unknown",
					"--stdin-filepath",
					"{buffer_path}"
				]
			}
		}
	]
}
