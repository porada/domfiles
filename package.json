{
	"name": "domfiles",
	"version": "0.0.0",
	"private": true,
	"license": "MIT",
	"author": {
		"name": "Dom Porada",
		"email": "dom@dom.engineering",
		"url": "https://dom.engineering"
	},
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@12.6.0",
	"dependencies": {
		"plugins": "^1.3.4",
		"skills": "^1.7.0",
		"vercel": "^59.25.4"
	},
	"devDependencies": {
		"@standard-config/oxlint": "^2.9.0",
		"@standard-config/oxlint-stylistic": "^2.9.0",
		"@standard-config/prettier": "^1.21.1",
		"@standard-config/tsconfig": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"prettier": "catalog:",
		"prettier-plugin-fish": "workspace:*",
		"prettier-plugin-rust": "workspace:*",
		"prettier-plugin-toml": "workspace:*",
		"typescript": "catalog:",
		"vite-plus": "catalog:"
	},
	"scripts": {
		"fix": "pnpm format && pnpm run '/^lint:[^:]+$/' && pnpm format",
		"format": "prettier --ignore-unknown --log-level=warn --write .",
		"format:check": "prettier --check --ignore-unknown .",
		"lint:fish": "home/.local/bin/domfiles-dev-lint-fish",
		"lint:json": "home/.local/bin/domfiles-dev-lint-json",
		"lint:rs": "home/.local/bin/domfiles-dev-lint-rs --fix",
		"lint:rs:check": "home/.local/bin/domfiles-dev-lint-rs",
		"lint:sh": "home/.local/bin/domfiles-dev-lint-sh",
		"lint:toml": "home/.local/bin/domfiles-dev-lint-toml",
		"lint:ts": "vp lint --fix",
		"lint:ts:check": "vp lint --deny-warnings --type-check",
		"prepare": "vp config --hooks-dir .hooks",
		"test": "pnpm run '/^test:[^:]+$/'",
		"test:rs": "RUSTFLAGS='-D warnings' cargo test --locked --workspace",
		"test:ts": "vp test",
		"typecheck": "tsc --noEmit"
	}
}
