{
	"name": "domfiles",
	"version": "0.0.0",
	"private": true,
	"license": "MIT",
	"author": {
		"name": "Dom Porada",
		"email": "dom@dom.engineering",
		"url": "https://dom.engineering"
	},
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@11.21.0",
	"dependencies": {
		"plugins": "^1.3.4",
		"skills": "^1.5.22"
	},
	"devDependencies": {
		"@standard-config/oxlint": "^2.6.0",
		"@standard-config/oxlint-stylistic": "^2.6.0",
		"@standard-config/prettier": "^1.19.2",
		"@standard-config/tsconfig": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"eslint": "^10.8.1",
		"prettier": "catalog:",
		"prettier-plugin-fish": "workspace:*",
		"prettier-plugin-rust": "workspace:*",
		"prettier-plugin-toml": "workspace:*",
		"typescript": "catalog:",
		"vite-plus": "catalog:"
	},
	"scripts": {
		"fix": "pnpm format && pnpm run '/^lint:(fish|rs|sh|ts)$/' && pnpm format",
		"format": "prettier --ignore-unknown --log-level=warn --write .",
		"format:check": "prettier --check --ignore-unknown .",
		"lint:fish": "bin/domfiles-dev-lint-fish",
		"lint:rs": "cargo clippy --all-features --all-targets --allow-dirty --allow-no-vcs --allow-staged --fix --locked --workspace",
		"lint:rs:check": "cargo clippy --all-features --all-targets --locked --workspace -- --deny warnings",
		"lint:sh": "bin/domfiles-dev-lint-sh",
		"lint:ts": "vp lint --fix",
		"lint:ts:check": "vp lint --deny-warnings --type-check",
		"prepare": "vp config",
		"test": "vp test",
		"typecheck": "tsc --noEmit"
	}
}
