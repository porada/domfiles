{
	"name": "domfiles",
	"version": "0.0.0",
	"private": true,
	"license": "MIT",
	"author": {
		"name": "Dom Porada",
		"email": "dom@dom.engineering",
		"url": "https://dom.engineering"
	},
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@12.15.0",
	"dependencies": {
		"doclint": "workspace:*",
		"skills": "^1.7.4",
		"vercel": "^65.2.0"
	},
	"devDependencies": {
		"@standard-config/oxlint": "^2.10.1",
		"@standard-config/oxlint-stylistic": "^2.10.1",
		"@standard-config/prettier": "^1.22.0",
		"@standard-config/tsconfig": "catalog:",
		"@types/node": "catalog:",
		"prettier": "catalog:",
		"prettier-plugin-fish": "workspace:*",
		"typescript": "catalog:",
		"vite-plus": "catalog:"
	},
	"scripts": {
		"fix": "pnpm format && pnpm run '/^lint:[^:]+$/' && pnpm format",
		"format": "prettier --ignore-unknown --log-level=warn --write .",
		"format:check": "prettier --check --ignore-unknown .",
		"lint:fish": "home/.local/bin/domfiles-dev-lint-fish",
		"lint:json": "home/.local/bin/domfiles-dev-lint-json",
		"lint:md": "doclint --fix",
		"lint:md:check": "doclint --max-warnings 0",
		"lint:sh": "home/.local/bin/domfiles-dev-lint-sh",
		"lint:ts": "vp lint --fix",
		"lint:ts:check": "vp lint --deny-warnings --type-check",
		"prepare": "vp config --hooks-dir .hooks",
		"test": "vp test",
		"test:skills": "node --test 'skills/{*,.*}/**/*.test.ts'",
		"typecheck": "tsc --noEmit"
	}
}
