{
	"name": "domfiles",
	"private": true,
	"license": "MIT",
	"author": {
		"name": "Dom Porada",
		"email": "dom@dom.engineering",
		"url": "https://dom.engineering"
	},
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@10.32.1",
	"devDependencies": {
		"@domfiles/prettier-plugin-fish": "workspace:*",
		"@standard-config/prettier": "^1.11.1",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"prettier": "catalog:"
	},
	"scripts": {
		"fix": "pnpm format && pnpm lint:fish && pnpm lint:sh && pnpm lint:ts && pnpm format",
		"format": "prettier --ignore-unknown --log-level=warn --write .",
		"format:check": "prettier --check --ignore-unknown .",
		"lint:fish": "bin/domfiles-dev-lint-fish",
		"lint:sh": "bin/domfiles-dev-lint-sh",
		"lint:ts": "pnpm --recursive lint",
		"lint:ts:check": "pnpm --recursive lint:check",
		"prepare": "husky"
	}
}
