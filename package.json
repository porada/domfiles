{
	"name": "domfiles",
	"version": "0.0.0",
	"private": true,
	"license": "MIT",
	"author": {
		"name": "Dom Porada",
		"email": "dom@dom.engineering",
		"url": "https://dom.engineering"
	},
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@11.1.2",
	"devDependencies": {
		"@domfiles/prettier-plugin-fish": "workspace:*",
		"@standard-config/eslint": "^2.2.0",
		"@standard-config/oxlint": "^1.9.0",
		"@standard-config/prettier": "^1.13.1",
		"@standard-config/tsconfig": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"eslint": "^10.3.0",
		"prettier": "catalog:",
		"typescript": "catalog:",
		"vite-plus": "^0.1.21",
		"vitest": "catalog:"
	},
	"scripts": {
		"fix": "pnpm format && pnpm run '/^lint:(fish|sh|ts)$/' && pnpm format",
		"format": "prettier --ignore-unknown --log-level=warn --write .",
		"format:check": "prettier --check --ignore-unknown .",
		"lint:fish": "bin/domfiles-dev-lint-fish",
		"lint:sh": "bin/domfiles-dev-lint-sh",
		"lint:ts": "vp lint --fix",
		"lint:ts:check": "vp lint --deny-warnings --type-check",
		"prepare": "vp config",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	}
}
