[alias]
	a = add -v
	c = commit -v
	p = pull
	v = view

	ch = checkout
	cx = checkout HEAD --
	cp = cherry-pick

	ra = rebase --abort
	rc = rebase --continue
	rs = rebase --skip

	branches = branch -a
	contributors = shortlog -sn
	names = show --name-only
	remotes = remote -v
	tags = tag -l

	skip = update-index --assume-unchanged
	unskip = update-index --no-assume-unchanged

	# Quick commits
	boom = commit -am '💥' --allow-empty --no-verify
	deps = commit -am 'Update dependencies'
	rd = commit -am 'Update `README`'

[commit]
	gpgSign = true

[core]
	excludesFile = ~/.config/git/ignore

[diff]
	algorithm = patience

[gpg]
	format = ssh

[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers

[init]
	defaultBranch = main

[merge]
	ff = only

[pager]
	diff = git-diff-highlight | less --chop-long-lines
	show = git-diff-highlight | less --chop-long-lines

[pull]
	rebase = true

[push]
	default = simple
	autoSetupRemote = true

[rebase]
	autoStash = true

[rerere]
	enabled = true

[status]
	showUntrackedFiles = all
	submoduleSummary = true

[tag]
	gpgSign = true

[user]
	# Please change these if you’re not me
	name = Dom Porada
	email = dom@dom.engineering
	signingKey = ~/.ssh/id_ed25519.pub
