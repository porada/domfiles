							"pattern": "^(?:(?:MANPAGER|PAGER)=cat )*command -v(?: |$)",
							"case_sensitive": true
						},
						{
							"pattern": "^(?:(?:MANPAGER|PAGER)=cat )*cp -n(?: [^-][^ ]*){2,}$",
							"case_sensitive": true
						},
						{
							"pattern": "^csrutil status$",
							"case_sensitive": true
						},
