						},
						{
							"pattern": "^https://(?:[^./?#:@]+\\.)+whatwg\\.org(?:[/?#]|$)"
						},
						{
							"pattern": "^https://(?:[^./?#:@]+\\.)+wordpress\\.org(?:[/?#]|$)"
						},
						{
