{
	"agent_buffer_font_size": 13,
	"agent_servers": {
		"codex-acp": {
			"default_config_options": {
				"fast-mode": false,
				"model": "gpt-5.6-sol",
				"reasoning_effort": "max"
			},
			"type": "registry"
		}
	},
	"autosave": "on_focus_change",
	"buffer_font_features": {
		"calt": false
	},
	"buffer_font_size": 14,
	"cli_default_open_behavior": "new_window",
	"collaboration_panel": {
		"button": false
	},
	"context_servers": {
		"grep": {
			"url": "https://mcp.grep.app"
		}
	},
	"debugger": {
		"button": false
	},
	"git": {
		"inline_blame": {
			"enabled": false
		}
	},
	"git_panel": {
		"dock": "left"
	},
	"gutter": {
		"runnables": false
	},
	"hard_tabs": true,
	"inline_code_actions": false,
	"language_servers": [
		"!eslint",
		"!tailwindcss-language-server",
		"..."
	],
	"outline_panel": {
		"dock": "left"
	},
	"project_panel": {
		"dock": "left",
		"hide_root": true
	},
	"scrollbar": {
		"cursors": false
	},
	"search": {
		"button": false
	},
	"show_whitespaces": "boundary",
	"tab_size": 4,
	"telemetry": {
		"diagnostics": false,
		"metrics": false
	},
	"terminal": {
		"button": false,
		"line_height": {
			"custom": 1.35
		}
	},
	"theme": "One Dark",
	"title_bar": {
		"show_user_picture": false
	},
	"toolbar": {
		"quick_actions": false
	},
	"ui_font_family": ".SystemUIFont",
	"ui_font_size": 15,
	"whitespace_map": {
		"tab": " "
	},
	"wrap_guides": [
		80,
		100
	],
	"agent": {
		"default_model": {
			"effort": "max",
			"enable_thinking": true,
			"model": "gpt-5.6-sol",
			"provider": "openai-subscribed"
		},
		"default_width": 360,
		"dock": "right",
		"enable_feedback": false,
		"expand_terminal_card": false,
		"limit_content_width": false,
		"sandbox_permissions": {
			"network_hosts": [
				"*.brew.sh",
				"*.github.com",
				"*.githubusercontent.com",
				"*.grep.app",
				"*.home-assistant.io",
				"*.npmjs.com",
				"*.npmjs.org",
				"*.shellcheck.net",
				"*.vim.org",
				"*.yarnpkg.com",
				"*.zizmor.sh",
				"brew.sh",
				"ffmpeg.org",
				"fishshell.com",
				"git-scm.com",
				"github.com",
				"githubusercontent.com",
				"grep.app",
				"jqlang.org",
				"mole.fit",
				"nodejs.org",
				"npmjs.com",
				"npmjs.org",
				"openai.com",
				"oxc.rs",
				"pnpm.io",
				"prettier.io",
				"pypi.org",
				"shellcheck.net",
				"vercel.com",
				"vim.org",
				"yarnpkg.com",
				"zed.dev",
				"zizmor.sh"
			]
		},
		"show_merge_conflict_indicator": false,
		"sidebar_side": "right",
		"tool_permissions": {
			"default": "allow",
			"tools": {
				"delete_path": {
					"default": "confirm"
				},
				"fetch": {
					"default": "confirm",
					"always_allow": [
						{
							"pattern": "^https://(?:[^./?#:@]+\\.)*brew\\.sh(?:[/?#]|$)"
						},
						{
							"pattern": "^https://ffmpeg\\.org(?:[/?#]|$)"
						},
						{
							"pattern": "^https://fishshell\\.com(?:[/?#]|$)"
						},
						{
							"pattern": "^https://git-scm\\.com(?:[/?#]|$)"
						},
						{
							"pattern": "^https://(?:[^./?#:@]+\\.)*github(?:usercontent)?\\.com(?:[/?#]|$)"
						},
						{
							"pattern": "^https://(?:[^./?#:@]+\\.)*grep\\.app(?:[/?#]|$)"
						},
						{
							"pattern": "^https://(?:[^./?#:@]+\\.)+home-assistant\\.io(?:[/?#]|$)"
						},
						{
							"pattern": "^https://jqlang\\.org(?:[/?#]|$)"
						},
						{
							"pattern": "^https://mole\\.fit(?:[/?#]|$)"
						},
						{
							"pattern": "^https://nodejs\\.org(?:[/?#]|$)"
						},
						{
							"pattern": "^https://(?:[^./?#:@]+\\.)*npmjs\\.(?:com|org)(?:[/?#]|$)"
						},
						{
							"pattern": "^https://openai\\.com(?:[/?#]|$)"
						},
						{
							"pattern": "^https://oxc\\.rs(?:[/?#]|$)"
						},
						{
							"pattern": "^https://pnpm\\.io(?:[/?#]|$)"
						},
						{
							"pattern": "^https://prettier\\.io(?:[/?#]|$)"
						},
						{
							"pattern": "^https://pypi\\.org(?:[/?#]|$)"
						},
						{
							"pattern": "^https://(?:[^./?#:@]+\\.)*shellcheck\\.net(?:[/?#]|$)"
						},
						{
							"pattern": "^https://vercel\\.com(?:[/?#]|$)"
						},
						{
							"pattern": "^https://(?:[^./?#:@]+\\.)*vim\\.org(?:[/?#]|$)"
						},
						{
							"pattern": "^https://(?:[^./?#:@]+\\.)*yarnpkg\\.com(?:[/?#]|$)"
						},
						{
							"pattern": "^https://zed\\.dev(?:[/?#]|$)"
						},
						{
							"pattern": "^https://(?:[^./?#:@]+\\.)*zizmor\\.sh(?:[/?#]|$)"
						}
					]
				},
				"move_path": {
					"default": "confirm"
				},
				"terminal": {
					"default": "confirm",
					"always_allow": [
						{
							"pattern": "^(?:basename|cat|cmp|diff|dirname|docker|du|echo|false|fd|ffprobe|file|find|fish_indent|grep|ha|head|jq|ls|lsof|mkdir|mktemp|nl|npm|pgrep|pnpm|printf|ps|pwd|readlink|realpath|rg|shasum|shellcheck|sort|stat|sw_vers|tail|test|tr|true|type|uname|uniq|wc|which|yarn|zed|zizmor)\\b"
						},
						{
							"pattern": "^(?:bash|fish|git|mo|mole|node|vim) --(?:help|version)$"
						},
						{
							"pattern": "^apk (?:--(?:help|version)$|(?:audit|dot|info|list|manifest|policy|search|stats|verify|version)\\b)"
						},
						{
							"pattern": "^(?:bash|sh) -n(?: --)? [^-][^ ]*$"
						},
						{
							"pattern": "^brew (?:--(?:prefix|version)|bundle check|config|deps|info|leaves|list|outdated|search|services list|uses)\\b"
						},
						{
							"pattern": "^command -v\\b"
						},
						{
							"pattern": "^curl --(?:help(?: [^ ]+)?|version)$"
						},
						{
							"pattern": "^defaults read\\b"
						},
						{
							"pattern": "^(?:bin/)?domfiles(?:$|(?: |-)(?:dependencies|dev-lint-fish|dev-lint-sh|dev-list-fish|dev-list-sh)\\b)"
						},
						{
							"pattern": "^fish (?:-n|--no-execute)\\b"
						},
						{
							"pattern": "^git (?:(?:--no-optional-locks|--no-pager) )*(?:blame|cat-file|check-attr|check-ignore|describe|diff|diff-files|diff-index|diff-tree|for-each-ref|grep|log|ls-files|ls-remote|merge-base|name-rev|range-diff|rev-list|rev-parse|shortlog|show|show-ref|status|version)\\b"
						},
						{
							"pattern": "^git (?:(?:--no-optional-locks|--no-pager) )*branch (?:--(?:list|show-current)\\b|[^-][^ ]*(?: [^-][^ ]*)?$)"
						},
						{
							"pattern": "^git (?:(?:--no-optional-locks|--no-pager) )*checkout -b [^-][^ ]*(?: [^-][^ ]*)?$"
						},
						{
							"pattern": "^git (?:(?:--no-optional-locks|--no-pager) )*clean (?:(?:.* )?(?:--dry-run|-[A-Za-z]*n[A-Za-z]*)\\b|-h$)"
						},
						{
							"pattern": "^git (?:(?:--no-optional-locks|--no-pager) )*config (?:(?:get|list)\\b|(?:(?:(?:-f|--(?:blob|file)) [^-][^ ]*|--(?:global|local|system|worktree)) )?(?:--list|--(?:get|get-all|get-regexp) [^-][^ ]*(?: [^-][^ ]*)?)(?: (?:-z|--(?:name-only|null|show-names|show-origin|show-scope)))*$)"
						},
						{
							"pattern": "^git (?:(?:--no-optional-locks|--no-pager) )*mv\\b"
						},
						{
							"pattern": "^git (?:(?:--no-optional-locks|--no-pager) )*reflog show\\b"
						},
						{
							"pattern": "^git (?:(?:--no-optional-locks|--no-pager) )*remote(?:$| -v$| (?:get-url|show)\\b)"
						},
						{
							"pattern": "^git (?:(?:--no-optional-locks|--no-pager) )*stash (?:list|show)\\b"
						},
						{
							"pattern": "^git (?:(?:--no-optional-locks|--no-pager) )*switch (?:-c|--create) [^-][^ ]*(?: [^-][^ ]*)?$"
						},
						{
							"pattern": "^git (?:(?:--no-optional-locks|--no-pager) )*tag (?:-l|--list)\\b"
						},
						{
							"pattern": "^git (?:(?:--no-optional-locks|--no-pager) )*worktree (?:add|list)\\b"
						},
						{
							"pattern": "^kill (?:-l|(?:-(?:0|9|15|KILL|TERM) )?[1-9][0-9]*(?: [1-9][0-9]*)*)$"
						},
						{
							"pattern": "^launchctl (?:list|print|print-disabled)\\b"
						},
						{
							"pattern": "^ln -s(?: --)? [^-][^ ]* [^-][^ ]*$"
						},
						{
							"pattern": "^node (?:-c|--check)(?: --)? [^-][^ ]*$"
						},
						{
							"pattern": "^CI=1 (?:npm|pnpm|yarn)\\b"
						},
						{
							"pattern": "^plutil -(?:lint|p)\\b"
						},
						{
							"pattern": "^rm -rf \\.pnpm-store$"
						},
						{
							"pattern": "^sed -n '(?:(?:[0-9]+|\\$|/[^/']*/)(?:,(?:[0-9]+|\\$|/[^/']*/))?)?p'(?: [^-][^ ]*)*$"
						},
						{
							"pattern": "^sleep (?:[0-9]|1[0-9])$"
						},
						{
							"pattern": "^LC_ALL=C sort\\b"
						},
						{
							"pattern": "^umask(?: (?:-[Sph]+|--(?:as-command|help|symbolic)))*$"
						}
					],
					"always_confirm": [
						{
							"pattern": "^fd (?:.* )?(?:--exec(?:-batch)?|-[^- ]*[xX][^- ]*)\\b"
						},
						{
							"pattern": "^find .*-(?:delete|exec(?:dir)?|ok(?:dir)?)\\b"
						},
						{
							"pattern": "^git (?:(?:--no-optional-locks|--no-pager) )*mv (?:--?[^- ][^ ]* )*(?:--force|-[A-Za-z]*f[A-Za-z]*)(?: |$)"
						},
						{
							"pattern": "^git (?:(?:--no-optional-locks|--no-pager) )*worktree add (?:.* )?(?:--f(?:o(?:r(?:c(?:e)?)?)?)?|-[A-Za-z]*B[^ ]*|-[A-Za-z]*f[A-Za-z]*)(?: |$)"
						},
						{
							"pattern": "^(?:CI=1 )?(?:npm (?:.* )?(?:(?:create|init|innit|x)\\b|exec(?:$| +(?:[^- ]|-$|-[^- ]|--$|--[^ ]|-- +(?:[^ ]{1,7}|[^ ]{9,}|[^p][^ ]{7}|p[^r][^ ]{6}|pr[^e][^ ]{5}|pre[^t][^ ]{4}|pret[^t][^ ]{3}|prett[^i][^ ]{2}|pretti[^e][^ ]|prettie[^r])(?: +|$))))|npx\\b)"
						},
						{
							"pattern": "^(?:CI=1 )?(?:pnpm (?:.* )?(?:create|dlx|init)|pnpx|pnx)\\b"
						},
						{
							"pattern": "^rg (?:.* )?--(?:hostname-bin|pre)(?:[ =]|$)"
						},
						{
							"pattern": "^(?:CI=1 )?yarn (?:.* )?(?:create|dlx|init)\\b"
						},
						{
							"pattern": "^zed .*--uninstall\\b"
						},
						{
							"pattern": "^zizmor (?:.* )?--gh-hostname(?:[ =]|$)"
						}
					]
				}
			}
		}
	}
}
