{
	"agent_buffer_font_size": 13,
	"agent_servers": {
		"codex-acp": {
			"default_config_options": {
				"fast-mode": false,
				"model": "gpt-5.6-sol",
				"reasoning_effort": "max"
			},
			"type": "registry"
		}
	},
	"autosave": "on_focus_change",
	"buffer_font_features": {
		"calt": false
	},
	"buffer_font_size": 14,
	"cli_default_open_behavior": "new_window",
	"collaboration_panel": {
		"button": false
	},
	"context_servers": {
		"grep": {
			"url": "https://mcp.grep.app"
		}
	},
	"debugger": {
		"button": false
	},
	"git": {
		"inline_blame": {
			"enabled": false
		}
	},
	"git_panel": {
		"dock": "left"
	},
	"gutter": {
		"runnables": false
	},
	"hard_tabs": true,
	"inline_code_actions": false,
	"language_servers": [
		"!eslint",
		"!tailwindcss-language-server",
		"..."
	],
	"languages": {
		"Plain Text": {
			"show_edit_predictions": false
		}
	},
	"outline_panel": {
		"dock": "left"
	},
	"project_panel": {
		"dock": "left",
		"hide_root": true
	},
	"scrollbar": {
		"cursors": false
	},
	"search": {
		"button": false
	},
	"show_whitespaces": "boundary",
	"tab_size": 4,
	"telemetry": {
		"diagnostics": false,
		"metrics": false
	},
	"terminal": {
		"button": false,
		"line_height": {
			"custom": 1.35
		},
		"scrollbar": {
			"show": "never"
		}
	},
	"theme": "One Dark",
	"title_bar": {
		"show_user_picture": false
	},
	"toolbar": {
		"quick_actions": false
	},
	"ui_font_family": ".SystemUIFont",
	"ui_font_size": 15,
	"whitespace_map": {
		"tab": " "
	},
	"wrap_guides": [
		80,
		100
	],
	"agent": {
		"default_model": {
			"effort": "max",
			"enable_thinking": true,
			"model": "gpt-5.6-sol",
			"provider": "openai-subscribed"
		},
		"default_width": 360,
		"dock": "right",
		"enable_feedback": false,
		"expand_terminal_card": false,
		"limit_content_width": false,
		"sandbox_permissions": {
			"network_hosts": [
				"*.brew.sh",
				"*.docker.com",
