							"case_sensitive": true
						},
						{
							"pattern": "^codesign (?:-[dv]+|--(?:display|verify))(?: (?:-v+|--(?:check-notarization|deep|ignore-resources|strict)|--verbose(?:=[0-9]+)?))*(?: --)?(?: [^-][^ ]*)+$",
							"case_sensitive": true
