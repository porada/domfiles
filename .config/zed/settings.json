{
	"agent_buffer_font_size": 13,
	"agent_servers": {
		"claude-acp": {
			"default_config_options": {
				"effort": "max",
				"mode": "auto",
				"model": "opus"
			},
			"type": "registry"
		}
	},
	"autosave": "on_focus_change",
	"buffer_font_features": {
		"calt": false
	},
	"buffer_font_size": 14,
	"cli_default_open_behavior": "new_window",
	"collaboration_panel": {
		"button": false
	},
	"context_servers": {
		"grep": {
			"url": "https://mcp.grep.app"
		}
	},
	"debugger": {
		"button": false
	},
	"diff_view_style": "unified",
	"file_types": {
		"Plain Text": [
			"TODO"
		]
	},
	"git": {
		"inline_blame": {
			"enabled": false
		}
	},
	"git_panel": {
		"dock": "left"
	},
	"gutter": {
		"runnables": false
	},
	"hard_tabs": true,
	"inline_code_actions": false,
	"language_servers": [
		"!eslint",
		"!tailwindcss-language-server",
		"..."
	],
	"languages": {
		"JavaScript": {
			"language_servers": [
				"typescript-ls",
				"!vtsls"
			]
		},
		"Plain Text": {
			"format_on_save": "off",
			"show_edit_predictions": false,
			"soft_wrap": "editor_width"
		},
		"TSX": {
			"language_servers": [
				"typescript-ls",
				"!vtsls"
			]
		},
		"TypeScript": {
			"language_servers": [
				"typescript-ls",
				"!vtsls"
			]
		}
	},
	"outline_panel": {
		"dock": "left"
	},
	"project_panel": {
		"dock": "left",
		"hide_root": true
	},
	"restore_on_startup": "empty_tab",
	"scrollbar": {
		"cursors": false,
		"selected_symbol": false,
		"selected_text": false
	},
	"search": {
		"button": false
	},
	"show_whitespaces": "boundary",
	"telemetry": {
		"diagnostics": false,
		"metrics": false
	},
	"terminal": {
		"button": false,
		"line_height": {
			"custom": 1.35
		},
		"scrollbar": {
			"show": "never"
		}
	},
	"theme": "One Dark",
	"title_bar": {
		"show_user_picture": false
	},
	"toolbar": {
		"quick_actions": false
	},
	"ui_font_family": ".SystemUIFont",
	"ui_font_size": 15,
	"whitespace_map": {
		"tab": " "
	},
	"wrap_guides": [
		80,
		100
	],
	"agent": {
		"auto_compact": {
			"threshold": "85%"
		},
		"default_model": {
			"effort": "max",
			"enable_thinking": true,
			"model": "gpt-5.6-sol",
			"provider": "openai-subscribed"
		},
		"default_width": 600,
		"dock": "right",
		"enable_feedback": false,
		"expand_terminal_card": false,
		"flexible": false,
		"limit_content_width": false,
		"sandbox_permissions": {
			"network_hosts": [
				"*.agentclientprotocol.com",
				"*.agentskills.io",
				"*.apple.com",
				"*.brew.sh",
				"*.chatgpt.com",
				"*.claude.com",
				"*.crates.io",
				"*.cve.org",
				"*.docker.com",
				"*.github.com",
				"*.githubusercontent.com",
				"*.gnu.org",
				"*.go.dev",
				"*.grep.app",
				"*.home-assistant.io",
				"*.iana.org",
				"*.mozilla.org",
				"*.npmjs.com",
				"*.npmjs.org",
				"*.openai.com",
				"*.php.net",
				"*.playwright.dev",
				"*.rfc-editor.org",
				"*.rust-lang.org",
				"*.schemastore.org",
				"*.shellcheck.net",
				"*.shields.io",
				"*.skills.sh",
				"*.typescriptlang.org",
				"*.vim.org",
				"*.w.org",
				"*.w3.org",
				"*.whatwg.org",
				"*.wordpress.net",
				"*.wordpress.org",
				"*.yarnpkg.com",
				"*.zizmor.sh",
				"add-skill.vercel.sh",
				"agent-browser.dev",
				"agentclientprotocol.com",
				"agentskills.io",
				"apple.com",
				"brew.sh",
				"cdn.jsdelivr.net",
				"chatgpt.com",
				"claude.ai",
				"claude.com",
				"code.visualstudio.com",
				"crates.io",
				"curl.se",
				"cursor.com",
				"cve.org",
				"cveawg.mitre.org",
				"docs.python.org",
				"docs.rs",
				"dom.engineering",
				"e18e.dev",
				"editorconfig.org",
				"eslint-react.xyz",
				"eslint.org",
				"eslint.style",
				"ffmpeg.org",
				"fishshell.com",
				"git-scm.com",
				"github.blog",
				"github.com",
				"githubusercontent.com",
				"gnu.org",
				"go.dev",
				"grep.app",
				"iana.org",
				"jqlang.org",
				"keith.github.io",
				"knip.dev",
				"man.openbsd.org",
				"man7.org",
				"manp.gs",
				"manpages.debian.org",
				"modelcontextprotocol.io",
				"mole.fit",
				"nextjs.org",
				"nodejs.org",
				"npmjs.com",
				"npmjs.org",
				"npmx.dev",
				"openai.com",
				"opensource.org",
				"oxc.rs",
				"pandoc.org",
				"perfectionist.dev",
				"playwright.dev",
				"pnpm.io",
				"porada.co",
				"prettier.io",
				"publint.dev",
				"pubs.opengroup.org",
				"pypi.org",
				"react.dev",
				"rfc-editor.org",
				"rust-lang.github.io",
				"rust-lang.org",
				"sass-lang.com",
				"shellcheck.net",
				"shields.io",
				"skills.sh",
				"skillsmp.com",
				"stylelint.io",
				"svgo.dev",
				"taplo.tamasfe.dev",
				"tsdown.dev",
				"turbo.build",
				"turborepo.com",
				"turborepo.dev",
				"unpkg.com",
				"vercel.com",
				"vim.org",
				"vite.dev",
				"viteplus.dev",
				"vitest.dev",
				"w3.org",
				"wordpress.org",
				"yarnpkg.com",
				"zed.dev",
				"zizmor.sh"
			]
		},
		"show_merge_conflict_indicator": false,
		"sidebar_side": "right",
		"tool_permissions": {
			"default": "allow",
			"tools": {
				"fetch": {
					"default": "confirm",
					"always_allow": [
						{
							"pattern": "^(?i:https://(?:[^./?#:@]+\\.)*[^./?#:@]+)(?:[/?#]|$)",
							"case_sensitive": true
						}
					],
					"always_confirm": [
						{
							"pattern": "^(?i:https://keith\\.github\\.io)(?:[?#]|$|/(?:$|[^x]|x(?:$|[^c])|xc(?:$|[^o])|xco(?:$|[^d])|xcod(?:$|[^e])|xcode(?:$|[^-])|xcode-(?:$|[^m])|xcode-m(?:$|[^a])|xcode-ma(?:$|[^n])|xcode-man(?:$|[^-])|xcode-man-(?:$|[^p])|xcode-man-p(?:$|[^a])|xcode-man-pa(?:$|[^g])|xcode-man-pag(?:$|[^e])|xcode-man-page(?:$|[^s])|xcode-man-pages(?:$|[^/])))",
							"case_sensitive": true
						}
					]
				}
			}
		}
	}
}
