{
	"agent_buffer_font_size": 13,
	"agent_servers": {
		"codex-acp": {
			"default_config_options": {
				"fast-mode": false,
				"model": "gpt-5.6-sol",
				"reasoning_effort": "max"
			},
			"type": "registry"
		}
	},
	"autosave": "on_focus_change",
	"buffer_font_features": {
		"calt": false
	},
	"buffer_font_size": 14,
	"cli_default_open_behavior": "new_window",
	"collaboration_panel": {
		"button": false
	},
	"debugger": {
		"button": false
	},
	"git": {
		"inline_blame": {
			"enabled": false
		}
	},
	"git_panel": {
		"dock": "left"
	},
	"gutter": {
		"runnables": false
	},
	"hard_tabs": true,
	"inline_code_actions": false,
	"outline_panel": {
		"dock": "left"
	},
	"project_panel": {
		"dock": "left",
		"hide_root": true
	},
	"scrollbar": {
		"cursors": false
	},
	"search": {
		"button": false
	},
	"show_whitespaces": "boundary",
	"telemetry": {
		"diagnostics": false,
		"metrics": false
	},
	"terminal": {
		"button": false,
		"line_height": {
			"custom": 1.35
		}
	},
	"theme": "One Dark",
	"title_bar": {
		"show_user_picture": false
	},
	"toolbar": {
		"quick_actions": false
	},
	"ui_font_family": ".SystemUIFont",
	"ui_font_size": 15,
	"whitespace_map": {
		"tab": " "
	},
	"wrap_guides": [
		80,
		100
	],
	"agent": {
		"default_model": {
			"effort": "max",
			"enable_thinking": true,
			"model": "gpt-5.6-sol",
			"provider": "openai-subscribed"
		},
		"default_width": 360,
		"dock": "right",
		"enable_feedback": false,
		"expand_terminal_card": false,
		"limit_content_width": false,
		"sandbox_permissions": {
			"network_hosts": [
				"*.brew.sh",
				"*.github.com",
				"*.githubusercontent.com",
				"*.npmjs.org",
				"brew.sh",
				"developers.home-assistant.io",
				"ffmpeg.org",
				"github.com",
				"githubusercontent.com",
				"npmjs.org",
				"pnpm.io",
				"zed.dev"
			]
		},
		"show_merge_conflict_indicator": false,
		"sidebar_side": "right",
		"tool_permissions": {
			"default": "allow",
			"tools": {
				"delete_path": {
					"default": "confirm"
				},
				"fetch": {
					"default": "confirm",
					"always_allow": [
						{
							"pattern": "^https://(?:[^./?#:@]+\\.)*brew\\.sh(?:[/?#]|$)"
						},
						{
							"pattern": "^https://developers\\.home-assistant\\.io(?:[/?#]|$)"
						},
						{
							"pattern": "^https://ffmpeg\\.org(?:[/?#]|$)"
						},
						{
							"pattern": "^https://(?:[^./?#:@]+\\.)*github\\.com(?:[/?#]|$)"
						},
						{
							"pattern": "^https://(?:[^./?#:@]+\\.)*githubusercontent\\.com(?:[/?#]|$)"
						},
						{
							"pattern": "^https://(?:[^./?#:@]+\\.)*npmjs\\.org(?:[/?#]|$)"
						},
						{
							"pattern": "^https://pnpm\\.io(?:[/?#]|$)"
						},
						{
							"pattern": "^https://zed\\.dev(?:[/?#]|$)"
						}
					]
				},
				"move_path": {
					"default": "confirm"
				},
				"terminal": {
					"default": "confirm",
					"always_allow": [
						{
							"pattern": "^(?:basename|cat|cmp|diff|dirname|docker|du|echo|fd|ffprobe|file|find|fish_indent|grep|ha|head|jq|ls|lsof|mktemp|nl|npm|pgrep|pnpm|printf|ps|pwd|readlink|realpath|rg|shasum|shellcheck|sort|stat|sw_vers|tail|test|tr|type|uname|uniq|wc|which|yarn|zed)\\b"
						},
						{
							"pattern": "^brew (?:--(?:prefix|version)|bundle check|config|deps|info|leaves|list|outdated|search|services list|uses)\\b"
						},
						{
							"pattern": "^command -v\\b"
						},
						{
							"pattern": "^defaults read\\b"
						},
						{
							"pattern": "^domfiles(?:$| (?:dependencies|dev-lint-fish|dev-lint-sh|dev-list-fish|dev-list-sh)\\b)"
						},
						{
							"pattern": "^fish (?:-n|--no-execute)\\b"
						},
						{
							"pattern": "^git (?:(?:--no-optional-locks|--no-pager) )*(?:blame|cat-file|check-attr|check-ignore|describe|diff|diff-files|diff-index|diff-tree|for-each-ref|grep|log|ls-files|ls-remote|merge-base|name-rev|range-diff|rev-list|rev-parse|shortlog|show|show-ref|status|version)\\b"
						},
						{
							"pattern": "^git (?:(?:--no-optional-locks|--no-pager) )*branch (?:--(?:list|show-current)\\b|[^-][^ ]*(?: [^-][^ ]*)?$)"
						},
						{
							"pattern": "^git (?:(?:--no-optional-locks|--no-pager) )*checkout -b [^-][^ ]*(?: [^-][^ ]*)?$"
						},
						{
							"pattern": "^git (?:(?:--no-optional-locks|--no-pager) )*clean (?:(?:.* )?(?:--dry-run|-[A-Za-z]*n[A-Za-z]*)\\b|-h$)"
						},
						{
							"pattern": "^git (?:(?:--no-optional-locks|--no-pager) )*config --(?:get|get-all|get-regexp|list)\\b"
						},
						{
							"pattern": "^git (?:(?:--no-optional-locks|--no-pager) )*mv\\b"
						},
						{
							"pattern": "^git (?:(?:--no-optional-locks|--no-pager) )*reflog show\\b"
						},
						{
							"pattern": "^git (?:(?:--no-optional-locks|--no-pager) )*remote(?:$| -v$| (?:get-url|show)\\b)"
						},
						{
							"pattern": "^git (?:(?:--no-optional-locks|--no-pager) )*stash (?:list|show)\\b"
						},
						{
							"pattern": "^git (?:(?:--no-optional-locks|--no-pager) )*switch (?:-c|--create) [^-][^ ]*(?: [^-][^ ]*)?$"
						},
						{
							"pattern": "^git (?:(?:--no-optional-locks|--no-pager) )*tag (?:-l|--list)\\b"
						},
						{
							"pattern": "^git (?:(?:--no-optional-locks|--no-pager) )*worktree (?:add|list)\\b"
						},
						{
							"pattern": "^kill (?:-l|(?:-(?:0|9|15|KILL|TERM) )?[1-9][0-9]*(?: [1-9][0-9]*)*)$"
						},
						{
							"pattern": "^launchctl (?:list|print|print-disabled)\\b"
						},
						{
							"pattern": "^plutil -(?:lint|p)\\b"
						},
						{
							"pattern": "^sed -n '[0-9]+(?:,[0-9]+)?p'(?: [^-][^ ]*)*$"
						},
						{
							"pattern": "^sh -n(?: --)? [^-][^ ]*$"
						}
					],
					"always_confirm": [
						{
							"pattern": "^fd (?:.* )?(?:--exec(?:-batch)?|-[^- ]*[xX][^- ]*)\\b"
						},
						{
							"pattern": "^find .*-(?:delete|exec(?:dir)?|ok(?:dir)?)\\b"
						},
						{
							"pattern": "^git (?:(?:--no-optional-locks|--no-pager) )*mv (?:--?[^- ][^ ]* )*(?:--force|-[A-Za-z]*f[A-Za-z]*)(?: |$)"
						},
						{
							"pattern": "^git (?:(?:--no-optional-locks|--no-pager) )*worktree add (?:.* )?(?:--f(?:o(?:r(?:c(?:e)?)?)?)?|-[A-Za-z]*B[^ ]*|-[A-Za-z]*f[A-Za-z]*)(?: |$)"
						},
						{
							"pattern": "^(?:npm (?:.* )?(?:create|exec|init|innit|x)|npx)\\b"
						},
						{
							"pattern": "^(?:pnpm (?:.* )?(?:create|dlx|init)|pnpx|pnx)\\b"
						},
						{
							"pattern": "^rg (?:.* )?--(?:hostname-bin|pre)(?:[ =]|$)"
						},
						{
							"pattern": "^yarn (?:.* )?(?:create|dlx|init)\\b"
						},
						{
							"pattern": "^zed .*--uninstall\\b"
						}
					]
				}
			}
		}
	}
}
