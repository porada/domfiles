				},
				"move_path": {
					"default": "confirm"
				},
				"terminal": {
					"default": "confirm",
					"always_allow": [
						{
							"pattern": "^(?:(?:MANPAGER|PAGER)=cat )*(?:basename|cat|cmp|diff|dirname|du|echo|false|fd|ffprobe|file|find|fish_indent|grep|ha|head|jq|ls|lsof|md5|md5sum|mkdir|mktemp|nl|npm|pgrep|pnpm|printf|ps|pwd|readlink|realpath|rg|shasum|shellcheck|sleep|sort|stat|sw_vers|tail|test|tr|true|type|uname|uniq|uptime|wc|which|whoami|xattr|yarn|zed|zizmor)\\b"
						},
						{
							"pattern": "^(?:(?:MANPAGER|PAGER)=cat )*(?:apk|bash|brew|corepack|curl|date|(?:nohup )?docker|fish|git|mo|mole|node|sh|sips|skills|tar|vim) --(?:help|version)$"
						},
						{
							"pattern": "^(?:(?:[0-9]+)?(?:>>?|>\\|)|&>>?) /tmp/(?:[.]{3,}|[.]*[^./ ][^/ ]*)$"
						},
						{
							"pattern": "^\\[ .*\\]$"
						},
						{
							"pattern": "^apk (?:audit|dot|info|list|manifest|policy|search|stats|verify|version)\\b"
						},
						{
							"pattern": "^(?:bash|sh) -n(?: --)? [^-][^ ]*$"
						},
						{
							"pattern": "^brew (?:--prefix|bundle check|config|deps|info|leaves|list|outdated|search|services list|uses)\\b"
						},
						{
							"pattern": "^command -v\\b"
						},
						{
							"pattern": "^(?:(?:MANPAGER|PAGER)=cat )*(?:CI=1 )?(?:nohup )?corepack (?:npm|pnpm|yarn)(?: |$)"
						},
						{
							"pattern": "^cp -n(?: [^-][^ ]*){2,}$"
						},
						{
							"pattern": "^(?:(?:MANPAGER|PAGER)=cat )*curl (?:--help [^ ]+|--disable --config [^-][^ ]* --version)$"
						},
						{
							"pattern": "^date(?: -u)?$"
						},
						{
							"pattern": "^defaults read\\b"
						},
						{
							"pattern": "^(?:(?:MANPAGER|PAGER)=cat )*(?:nohup )?docker (?:(?:(?:--(?:config|context|host|log-level|tlscacert|tlscert|tlskey)(?:=| )[^ ]+|-[Hcl](?:[^ ]+| [^ ]+)|--(?:debug|tls|tlsverify)(?:=[^ ]+)?|-D) )*)(?:diff|events|history|images|info|inspect|logs|port|ps|search|stats|top|version|wait|compose (?:(?:(?:--(?:ansi|env-file|file|parallel|profile|progress|project-directory|project-name)(?:=| )[^ ]+|-[fp](?:[^ ]+| [^ ]+)|--(?:all-resources|compatibility|dry-run)(?:=[^ ]+)?) )*)(?:config|events|images|logs|ls|port|ps|stats|top|version|volumes|wait)|container (?:diff|inspect|logs|ls|port|stats|top|wait)|context (?:inspect|ls|show)|image (?:history|inspect|ls)|network (?:inspect|ls)|system (?:df|events|info)|volume (?:inspect|ls))\\b"
						},
						{
							"pattern": "^(?:bin/)?domfiles(?:$|(?: |-)(?:dependencies|dev-lint-fish|dev-lint-sh|dev-list-fish|dev-list-sh)\\b)"
						},
						{
							"pattern": "^fish (?:-n|--no-execute)\\b"
						},
						{
							"pattern": "^git (?:(?:--no-optional-locks|--no-pager) )*(?:blame|cat-file|check-attr|check-ignore|describe|diff|diff-files|diff-index|diff-tree|for-each-ref|grep|log|ls-files|ls-remote|merge-base|name-rev|range-diff|rev-list|rev-parse|shortlog|show|show-ref|status|version)\\b"
						},
						{
							"pattern": "^git (?:(?:--no-optional-locks|--no-pager) )*branch (?:(?:-a|--all)(?: --contains [^-][^ ]*)?$|--(?:list|show-current)\\b|[^-][^ ]*(?: [^-][^ ]*)?$)"
						},
						{
							"pattern": "^git (?:(?:--no-optional-locks|--no-pager) )*checkout -b [^-][^ ]*(?: [^-][^ ]*)?$"
						},
						{
							"pattern": "^git (?:(?:--no-optional-locks|--no-pager) )*clean (?:(?:.* )?(?:--dry-run|-[A-Za-z]*n[A-Za-z]*)\\b|-h$)"
						},
						{
							"pattern": "^git (?:(?:--no-optional-locks|--no-pager) )*config (?:(?:get|list)\\b|(?:(?:(?:-f|--(?:blob|file)) [^-][^ ]*|--(?:global|local|system|worktree)) )?(?:--list|--(?:get|get-all|get-regexp) [^-][^ ]*(?: [^-][^ ]*)?)(?: (?:-z|--(?:name-only|null|show-names|show-origin|show-scope)))*$)"
						},
						{
							"pattern": "^git (?:(?:--no-optional-locks|--no-pager) )*mv\\b"
						},
						{
							"pattern": "^git (?:(?:--no-optional-locks|--no-pager) )*reflog show\\b"
						},
						{
							"pattern": "^git (?:(?:--no-optional-locks|--no-pager) )*remote(?:$| -v$| (?:get-url|show)\\b)"
						},
						{
							"pattern": "^git (?:(?:--no-optional-locks|--no-pager) )*stash (?:list\\b|pop -h$|show\\b)"
						},
						{
							"pattern": "^git (?:(?:--no-optional-locks|--no-pager) )*switch (?:-c|--create) [^-][^ ]*(?: [^-][^ ]*)?$"
						},
						{
							"pattern": "^git (?:(?:--no-optional-locks|--no-pager) )*tag (?:-l|--list)\\b"
						},
						{
							"pattern": "^git (?:(?:--no-optional-locks|--no-pager) )*worktree (?:add|list)\\b"
						},
						{
							"pattern": "^hostname(?: -(?:d|f|s))?$"
						},
						{
							"pattern": "^kill (?:-l|(?:-(?:0|9|15|KILL|TERM) )?[1-9][0-9]*(?: [1-9][0-9]*)*)$"
						},
						{
							"pattern": "^launchctl (?:list|print|print-disabled)\\b"
						},
						{
							"pattern": "^ln -s(?: --)? [^-][^ ]* [^-][^ ]*$"
						},
						{
							"pattern": "^(?:(?:(?:MANPAGER|PAGER)=cat )+man(?: |$)|man -h$)"
						},
						{
							"pattern": "^node (?:-c|--check)(?: --)? [^-][^ ]*$"
						},
						{
							"pattern": "^(?:(?:MANPAGER|PAGER)=cat )*(?:CI=1 (?:nohup )?|nohup )(?:npm|pnpm|yarn)\\b"
						},
						{
							"pattern": "^pkgutil (?:(?:--(?:only-dirs|only-files|regexp|verbose)|-v|--volume [^-][^ ]*) )*(?:--help|--(?:groups(?:-plist)?|packages|pkgs(?:-plist)?)|--pkgs=[^ ]+|--(?:check-signature|export-plist|file-info(?:-plist)?|files|group-pkgs|lsbom|payload-files|pkg-groups|pkg-info(?:-plist)?) [^-][^ ]*)$"
						},
						{
							"pattern": "^plugins(?:$| (?:-h|--help)$| (?:discover|targets)\\b)"
						},
						{
							"pattern": "^plutil -(?:lint|p)\\b"
						},
						{
							"pattern": "^rm (?:-r?f /tmp/(?:[.]{3,}|[.]*[^./ ][^/ ]*)(?: /tmp/(?:[.]{3,}|[.]*[^./ ][^/ ]*))*|-rf \\.pnpm-store)$"
						},
						{
							"pattern": "^sed -n '?(?:(?:[0-9]+|\\$|/[^/']*/)(?:,(?:[0-9]+|\\$|/[^/']*/))?)?p'?(?: [^-][^ ]*)*$"
						},
						{
							"pattern": "^sips (?:(?:-[Hhv]|--(?:formats|helpProperties))|--verify(?: [^-][^ ]*)+|(?:(?:(?:-1|--oneLine)|(?:-g|--getProperty) [^-][^ ]*) )+[^-][^ ]*(?: [^-][^ ]*)*)$"
						},
						{
							"pattern": "^skills(?:$| -(?:h|v)$| (?:find|list|ls)\\b)"
						},
						{
							"pattern": "^LC_ALL=C sort\\b"
						},
						{
							"pattern": "^tar -(?:t(?:v)?|xk(?:v)?|xvk)f [^-][^ ]*(?: -C [^-][^ ]*)?(?: [^-][^ ]*)*$"
						},
						{
							"pattern": "^umask(?: (?:-[Sph]+|--(?:as-command|help|symbolic)))*$"
						}
					],
					"always_confirm": [
						{
							"pattern": "^(?:(?:MANPAGER|PAGER)=cat )*(?:nohup )?docker (?:(?:(?:--(?:config|context|host|log-level|tlscacert|tlscert|tlskey)(?:=| )[^ ]+|-[Hcl](?:[^ ]+| [^ ]+)|--(?:debug|tls|tlsverify)(?:=[^ ]+)?|-D) )*)compose (?:(?:(?:--(?:ansi|env-file|file|parallel|profile|progress|project-directory|project-name)(?:=| )[^ ]+|-[fp](?:[^ ]+| [^ ]+)|--(?:all-resources|compatibility|dry-run)(?:=[^ ]+)?) )*)(?:config (?:.* )?(?:--lock-image-digests(?:[ =]|$)|--output(?:[ =]|$)|-[A-Za-z]*o[^ ]*(?: |$))|wait (?:.* )?--down-project(?:[ =]|$))"
						},
						{
							"pattern": "^(?:(?:MANPAGER|PAGER)=cat )*fd (?:.* )?(?:--exec(?:-batch)?|-[^- ]*[xX][^- ]*)\\b"
						},
						{
							"pattern": "^(?:(?:MANPAGER|PAGER)=cat )*find .*-(?:delete|exec(?:dir)?|ok(?:dir)?)\\b"
						},
						{
							"pattern": "^(?:(?:MANPAGER|PAGER)=cat )*git (?:(?:--no-optional-locks|--no-pager) )*mv (?:--?[^- ][^ ]* )*(?:--force|-[A-Za-z]*f[A-Za-z]*)(?: |$)"
						},
						{
							"pattern": "^(?:(?:MANPAGER|PAGER)=cat )*git (?:(?:--no-optional-locks|--no-pager) )*worktree add (?:.* )?(?:--f(?:o(?:r(?:c(?:e)?)?)?)?|-[A-Za-z]*B[^ ]*|-[A-Za-z]*f[A-Za-z]*)(?: |$)"
						},
						{
							"case_sensitive": true,
							"pattern": "^(?:(?:MANPAGER|PAGER)=cat )*man (?:.* )?-[^- ]*P[^ ]*(?: |$)"
						},
						{
							"pattern": "^(?:(?:MANPAGER|PAGER)=cat )*(?:CI=1 )?(?:nohup )?(?:corepack )?(?:npm (?:.* )?(?:(?:create|init|innit|x)\\b|exec(?:$| +(?:[^- ]|-$|-[^- ]|--$|--[^ ]|-- +(?:[^ ]{1,7}|[^ ]{9,}|[^p][^ ]{7}|p[^r][^ ]{6}|pr[^e][^ ]{5}|pre[^t][^ ]{4}|pret[^t][^ ]{3}|prett[^i][^ ]{2}|pretti[^e][^ ]|prettie[^r])(?: +|$))))|npx\\b)"
						},
						{
							"pattern": "^(?:(?:MANPAGER|PAGER)=cat )*(?:CI=1 )?(?:nohup )?(?:corepack )?(?:pnpm (?:.* )?(?:create|dlx|init)|pnpx|pnx)\\b"
						},
						{
							"pattern": "^(?:(?:MANPAGER|PAGER)=cat )*rg (?:.* )?--(?:hostname-bin|pre)(?:[ =]|$)"
						},
						{
							"pattern": "^(?:(?:MANPAGER|PAGER)=cat )*xattr (?:.* )?-[^- ]*[cdw][^- ]*(?: |$)"
						},
						{
							"pattern": "^(?:(?:MANPAGER|PAGER)=cat )*(?:CI=1 )?(?:nohup )?(?:corepack )?yarn (?:.* )?(?:create|dlx|init)\\b"
						},
						{
							"pattern": "^(?:(?:MANPAGER|PAGER)=cat )*zed .*--uninstall\\b"
						},
						{
							"pattern": "^(?:(?:MANPAGER|PAGER)=cat )*zizmor (?:.* )?--gh-hostname(?:[ =]|$)"
						}
					]
				}
			}
		}
