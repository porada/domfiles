[alias]
	a = add --verbose
	c = commit
	p = pull
	v = view

	ch = checkout
	cx = checkout HEAD --
	cp = cherry-pick

	ra = rebase --abort
	rc = rebase --continue
	rs = rebase --skip

	branches = branch --all
	contributors = shortlog --numbered --summary
	names = show --name-only
	renames = show --diff-filter=R --find-renames --summary
	remotes = remote --verbose
	tags = tag --list

	skip = update-index --assume-unchanged
	unskip = update-index --no-assume-unchanged

	# Quick commits
	boom = commit --all --allow-empty --message '💥' --no-verify
	deps = commit --all --message 'Update dependencies'
	rd = commit --all --message 'Update `README`'

[commit]
	gpgSign = true
	verbose = true

[credential]
	interactive = false

[diff]
	algorithm = histogram

[fetch]
	prune = true

[gpg]
	format = ssh

[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers

[init]
	defaultBranch = main

[interactive]
	diffFilter = git-diff-highlight

[merge]
	conflictStyle = zdiff3
	ff = only

[pager]
	branches = false
	contributors = false
	diff = git-diff-highlight | less --chop-long-lines
	remotes = false
	renames = false
	show = git-diff-highlight | less --chop-long-lines
	tags = false

[pull]
	rebase = true

[push]
	autoSetupRemote = true
	followTags = true

[rebase]
	autoSquash = true
	autoStash = true

[rerere]
	enabled = true

[status]
	submoduleSummary = true

[tag]
	gpgSign = true
	sort = version:refname

[user]
	# Please change these if you’re not me
	name = Dom Porada
	email = dom@dom.engineering
	signingKey = ~/.ssh/id_ed25519.pub
