#!/bin/sh

# shellcheck source=bin/domlib
. "$(dirname "$(realpath "$0")")/domlib"

# Abort when skipped files would be affected by the reset
skipped="$(__git_skipped_files .)"

if [ -n "$skipped" ]; then
  __print_error_and_exit 'Cannot reset the repository while it contains skipped files'
fi

__ git reset --hard "$@"
