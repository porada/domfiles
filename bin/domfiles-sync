#!/bin/sh

# shellcheck source=bin/domlib
. "$(dirname "$(realpath "$0")")/domlib"

# shellcheck disable=SC2119
if ! __is_brew_installed; then
  __print_error_and_exit '`brew` needs to be installed before running `domfiles sync`'
fi

sync_repository=false

if __is_callable git; then
  if branch="$(git -C "$DOMFILES" symbolic-ref --quiet --short HEAD)"; then
    case "$branch" in
      main | master)
        sync_repository=true
        ;;
      *)
        __print_info "Skipping repository update on branch \`$branch\`"
        ;;
    esac
  else
    status="$?"

    if [ "$status" -eq 1 ]; then
      __print_info 'Skipping repository update because `HEAD` does not reference a branch'
    else
      __print_error 'Failed to identify the current branch'
    fi
  fi
fi

if [ "$sync_repository" = true ]; then
  stash_failed=false
  stashed_changes=false

  __print_heading 'Syncing domfiles'

  # Ensure the remote uses SSH
  if __is_ssh_configured; then
    current="$(git -C "$DOMFILES" remote get-url origin)"
    updated="$(__string_replace "$current" 'https://github.com/' 'git@github.com:')"
    updated="$(__string_replace "$updated" 'porada/dotfiles' 'porada/domfiles')"

    if __is_macos; then
      __print_heading_dimmed 'Ensuring the SSH key is linked to Apple Keychain'
      __ssh_add --apple-use-keychain "$DOMFILES_SSH_KEY" || true
    fi

    if [ "$current" = "$updated" ]; then
      __print_confirmation "$current"
    elif __ git -C "$DOMFILES" ls-remote "$updated" HEAD > /dev/null; then
      __ git -C "$DOMFILES" remote set-url origin "$updated"
    else
      __print_error "Failed to verify SSH access to \`$updated\`. Leaving \`origin\` as \`$current\`"
    fi
  fi

  __print_heading_dimmed 'Fetching the latest changes'
  current_revision="$(__domfiles_revision)"

  if ! __ git -C "$DOMFILES" fetch --quiet; then
    __print_error 'Failed to fetch the latest changes'
  elif __ git -C "$DOMFILES" merge-base --is-ancestor '@{u}' HEAD; then
    __print_confirmation 'Up to date'
  else
    merge_base_status="$?"

    if [ "$merge_base_status" -ne 1 ]; then
      __print_error 'Failed to compare the local and upstream revisions'
    else
      skipped_files="$(__git_skipped_files "$DOMFILES")"

      if [ -n "$skipped_files" ]; then
        __print_error 'Cannot update the repository while it contains skipped files'
      else
        __print_heading 'Updating the repository'

        if ! __domfiles_is_clean; then
          __print_warning 'The repository contains uncommitted changes'

          if ! stash_list="$(git -C "$DOMFILES" stash list --format='%H')"; then
            __print_error 'Failed to stash uncommitted changes'
            stash_failed=true
          elif ! __ git -C "$DOMFILES" stash; then
            __print_error 'Failed to stash uncommitted changes'
            stash_failed=true
          elif ! updated_stash_list="$(git -C "$DOMFILES" stash list --format='%H')"; then
            __print_error 'Failed to verify stashed changes'
            stash_failed=true
            stashed_changes=true
          elif [ "$updated_stash_list" != "$stash_list" ]; then
            stashed_changes=true
          fi
        fi

        if [ "$stash_failed" = false ]; then
          if ! __ git -C "$DOMFILES" rebase; then
            echo
            __print_error 'Failed to update the repository'
            __ git -C "$DOMFILES" rebase --abort || true
          else
            __print_confirmation 'Repository updated'
          fi
        fi
      fi
    fi
  fi

  if [ "$stashed_changes" = true ]; then
    if __ git -C "$DOMFILES" stash pop --index --quiet; then
      __print_confirmation 'Changes restored'
    else
      __print_error 'Failed to restore uncommitted changes'

      __print_heading_dimmed 'Restoring the original state'
      skipped_files="$(__git_skipped_files "$DOMFILES")"

      if [ -n "$skipped_files" ]; then
        __print_error 'Cannot restore the original state while the repository contains skipped files'
      else
        if ! __ git -C "$DOMFILES" reset --hard "$current_revision"; then
          __print_error 'Failed to restore the original state'
        elif __ git -C "$DOMFILES" stash pop --index --quiet; then
          __print_confirmation 'Original state restored'
        else
          __print_error 'Failed to restore the original state'
        fi
      fi
    fi
  fi

  if [ "$(__domfiles_revision)" != "$current_revision" ]; then
    __print_heading_dimmed 'Restarting the sync after the update'
    __domfiles_exec --print sync
  fi
fi

__domfiles sync-migrate
__domfiles sync-setup
__domfiles sync-install
__domfiles sync-macos
__domfiles sync-update
__domfiles sync-clean

# Finish with dependency status
__print_heading 'Sync complete'
__domfiles dependencies || true
__is_fish || echo

# Record the last complete sync
date +%s > "$DOMFILES/.lastsync"
