#!/bin/sh

# shellcheck source=bin/domlib
. "$(dirname "$(realpath "$0")")/domlib"

# Show the current `git status` including skipped files
git status --short "$@" || exit $?

# Forward explicitly separated pathspecs to `git-skipped`
while [ $# -gt 0 ] && [ "$1" != '--' ]; do
  shift
done

[ $# -eq 0 ] || shift
__domfiles_bin git-skipped "$@"
