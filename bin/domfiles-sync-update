#!/bin/sh

# shellcheck source=bin/domlib
. "$(dirname "$(realpath "$0")")/domlib"

# Update `pnpm` packages
if __is_callable pnpm; then
  __print_heading 'Updating `pnpm` packages'
  __is_ci && __ pnpm --version
  __ pnpm --dir "$HOME" update --global --loglevel=error
fi

# Update `skills`
if __is_callable skills; then
  __print_heading 'Updating `skills`'
  __is_ci && __ skills --version
  __ skills update --global
fi

# Update Fish plugins
if __is_callable fish && __is_fisher_installed; then
  __print_heading 'Updating `fisher` plugins'

  if __is_ci; then
    __ fish --version
    __ fish --command 'fisher --version'
  fi

  if ! __ fish --command 'fisher update'; then
    __print_error 'Update failed'
  fi
fi

# Update Vim plugins
if __is_callable vim && __is_vim_plug_installed; then
  __print_heading 'Updating Vim plugins'
  __is_ci && __ vim --version | head -n 2

  if ! __ vim -c 'PlugUpgrade | PlugUpdate | PlugClean! | quitall'; then
    __print_error 'Update failed'
  fi
fi
