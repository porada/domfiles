#!/bin/sh

# shellcheck source=bin/domlib
. "$(dirname "$(realpath "$0")")/domlib"

# Lint YAML files that come with domfiles
# (lints all files when no paths are provided)
__domfiles_cd_root

lint_default_files() {
  git ls-files --cached --others --exclude-standard -- '*.yaml'
}

lint_file() {
  __ yq eval-all 'select(false)' -- "$1"
}

__domfiles_dev_lint 'YAML files' "$@"
