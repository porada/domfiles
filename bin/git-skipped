#!/bin/sh

# shellcheck source=bin/domlib
. "$(dirname "$(realpath "$0")")/domlib"

# Show files ignored by `git update-index --assume-unchanged`
print_skipped() {
  printf '\033[1;33m S\033[0m %s\n' "${1#h }"
}

# Preserve caller-relative parameters
prefix="$(git rev-parse --show-prefix)" || exit $?
params="$(git rev-parse --sq --prefix "$prefix" -- "$@")" || exit $?
eval "set $params"
unset params prefix

__git_cd_root

files="$(git ls-files -v -- "$@")"
files="$(printf '%s\n' "$files" | __grep '^h')"
[ -z "$files" ] && exit 0

printf '%s\n' "$files" \
  | while IFS= read -r file; do
    print_skipped "$file"
  done
