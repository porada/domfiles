#!/bin/sh

# shellcheck source=bin/domlib
. "$(dirname "$(realpath "$0")")/domlib"

# Match `git status` color output
if [ -t 1 ]; then
  output_is_tty=true
else
  output_is_tty=false
fi

color="$(git config --get-colorbool color.status "$output_is_tty")" || exit $?
unset output_is_tty

# Show skipped files marked `--assume-unchanged`
print_skipped() {
  if [ "$color" = true ]; then
    printf '\033[1;33m S\033[0m %s\n' "${1#? }"
  else
    printf ' S %s\n' "${1#? }"
  fi
}

files="$(__git_skipped_files . "$@")"
[ -z "$files" ] && exit 0

printf '%s\n' "$files" \
  | while IFS= read -r file; do
    print_skipped "$file"
  done
