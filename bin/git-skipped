#!/bin/sh

# shellcheck source=bin/domlib
. "$(dirname "$(realpath "$0")")/domlib"

# Show skipped files marked `--assume-unchanged`
print_skipped() {
  printf '\033[1;33m S\033[0m %s\n' "${1#h }"
}

# Preserve parameters relative to the caller
prefix="$(git rev-parse --show-prefix)" || exit $?
params="$(git rev-parse --sq --prefix "$prefix" -- "$@")" || exit $?
eval "set $params"
unset params prefix

__git_cd_root

files="$(__git_skipped_files . "$@")"
[ -z "$files" ] && exit 0

printf '%s\n' "$files" \
  | while IFS= read -r file; do
    print_skipped "$file"
  done
