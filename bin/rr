#!/bin/sh

# shellcheck source=bin/domlib
. "$(dirname "$(realpath "$0")")/domlib"

# Recursively remove files or directories that match the given pattern
if [ $# -ne 1 ]; then
  __print_error_and_exit '`rr` requires one argument'
fi

__print_warning "Remove all instances of \`$1\`?"
read -r _

__ find . -mindepth 1 -name "$1" -prune -exec rm -rf '{}' '+' -print
