#!/bin/sh

# shellcheck source=domlib
. "$(dirname "$(realpath "$0")")/domlib"

# Create a new branch based on the name of the current one
__git_cd_root

if branch="$(git symbolic-ref --quiet --short HEAD)"; then
  __ git checkout -b "wip/$branch"
else
  status="$?"
  [ "$status" -eq 1 ] || exit "$status"
  __print_error_and_exit 'Creating a `wip` branch requires `HEAD` to reference a branch'
fi
