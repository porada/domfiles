#!/bin/sh

# shellcheck source=bin/domlib
. "$(dirname "$(realpath "$0")")/domlib"

# Print the most recent commits or filter all commits by a search term
if [ $# -gt 0 ]; then
  log="$(eval "git --no-pager log $(__git_default_log_params --no-refs) --color=always")"
  printf '%s\n' "$log" | __grep -i -- "$*"
else
  eval "git --no-pager log $(__git_default_log_params) -n $(__git_default_commit_count)"
fi
