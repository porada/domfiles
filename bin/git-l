#!/bin/sh

# shellcheck source=bin/domlib
. "$(dirname "$(realpath "$0")")/domlib"

# Print recent or all commits, or filter all commits by a search term
color_mode=never
show_all=false

__is_stdout_tty && color_mode=always

if [ "${1-}" = '--all' ]; then
  show_all=true
  shift
fi

print_log() {
  git --no-pager log --no-notes --no-show-signature "$@"
}

if [ $# -gt 0 ]; then
  log="$(print_log --color="$color_mode" \
    --decorate-refs-exclude='*' \
    --decorate-refs-exclude=HEAD)"

  matches="$(printf '%s\n' "$log" | __grep --color="$color_mode" -i -- "$*")" || exit $?
  [ -z "$matches" ] || printf '%s\n' "$matches" | __page_input log
elif [ "$show_all" = true ]; then
  log="$(print_log --color="$color_mode")"
  printf '%s\n' "$log" | __page_input log
else
  default_count="$(__git_default_commit_count)"
  commit_count="$default_count"
  minimum_count="$(((default_count + 1) / 2))"

  if __is_stdout_tty && [ "$default_count" -gt 0 ]; then
    # shellcheck disable=SC2119
    if terminal_size="$(__terminal_get_available_size)"; then
      available_rows="${terminal_size%% *}"
      terminal_columns="${terminal_size##* }"

      # Measure entries without counting color escapes
      entries="$(print_log --color=never -n "$default_count")"
      commit_count="$(__terminal_count_fitting_lines "$terminal_columns" "$available_rows" "$entries")"

      if [ "$commit_count" -lt "$minimum_count" ]; then
        commit_count="$minimum_count"
      fi
    fi
  fi

  print_log --color="$color_mode" -n "$commit_count"
fi
