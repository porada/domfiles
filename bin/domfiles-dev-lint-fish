#!/bin/sh

# shellcheck source=bin/domlib
. "$(dirname "$(realpath "$0")")/domlib"

# Lint Fish shell scripts that come with domfiles
# (lints all files when no paths are provided)
__domfiles_cd_root

if [ $# -eq 0 ]; then
  files="$("$DOMFILES_BIN_DIR/domfiles-dev-list-fish")"
  __ifs_set
  # shellcheck disable=SC2086
  set -- $files
  __ifs_restore
fi

if [ $# -eq 1 ]; then
  __print_heading "Linting \`$1\`"
else
  __print_heading 'Linting Fish scripts'
fi

__ifs_set

for file in "$@"; do
  __ fish --no-execute -- "$file"
done

__ifs_restore
