#!/bin/sh

# shellcheck source=bin/domlib
. "$(dirname "$(realpath "$0")")/domlib"

# Lint Fish shell scripts that come with domfiles
# (lints all files when no paths are provided)
__domfiles_cd_root

if [ $# -eq 0 ]; then
  set --
  for file in .config/fish/*.fish .config/fish/functions/fish_*.fish; do
    if [ "$file" != '.config/fish/local.fish' ] && git check-ignore --quiet -- "$file"; then
      continue
    fi

    set -- "$@" "$file"
  done
fi

if [ $# -eq 1 ]; then
  __print_heading "Linting \`$1\`"
else
  __print_heading 'Linting Fish scripts'
fi

__ifs_set

for file in "$@"; do
  if [ ! -f "$file" ] || [ -L "$file" ]; then
    continue
  fi

  __ fish --no-execute -- "$file"
done

__ifs_restore
