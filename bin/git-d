#!/bin/sh

# shellcheck source=bin/domlib
. "$(dirname "$(realpath "$0")")/domlib"

# Show formatted `git diff` output
if [ $# -eq 0 ]; then
  __git_cd_root
  excluded_paths="$(__git_diff_excluded_paths --worktree)"

  if [ -n "$excluded_paths" ]; then
    exclude_params="$(__git_diff_exclude_params "$excluded_paths")"
    excluded_paths="$(__git_diff_excluded_paths --worktree --related)"

    # shellcheck disable=SC2086
    if git diff --quiet -- . $exclude_params; then
      git diff -- $excluded_paths
      exit $?
    else
      status="$?"
      [ "$status" -eq 1 ] || exit "$status"
    fi

    # shellcheck disable=SC2086
    stat_output="$(git diff --stat --color=always -- $excluded_paths)" || exit $?
    # shellcheck disable=SC2086
    patch_output="$(git diff --patch --color=always -- . $exclude_params)" || exit $?

    __git_diff_page "$stat_output" "$patch_output" --leading-newline
    exit $?
  fi
fi

git diff "$@"
