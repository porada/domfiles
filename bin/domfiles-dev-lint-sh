#!/bin/sh

# shellcheck source=bin/domlib
. "$(dirname "$(realpath "$0")")/domlib"

# Lint POSIX shell scripts that come with domfiles
# (lints all files when no paths are provided)
__domfiles_cd_root

if [ $# -eq 0 ]; then
  set -- .hooks/* bin/*
fi

if [ $# -eq 1 ]; then
  __print_heading "Linting \`$1\`"
else
  __print_heading 'Linting POSIX shell scripts'
fi

__ifs_set

for file in "$@"; do
  if [ ! -f "$file" ] || [ -L "$file" ]; then
    continue
  fi

  __ shellcheck --external-sources -- "$file"
done

__ifs_restore
