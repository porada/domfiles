#!/bin/sh

# shellcheck source=bin/domlib
. "$(dirname "$(realpath "$0")")/domlib"

# Lint POSIX shell scripts that come with domfiles
# (lints all files when no paths are provided)
__domfiles_cd_root

lint_default_files() {
  git ls-files --cached --others --exclude-standard -- '*.sh' '.hooks/*' 'bin/*'
}

lint_file() {
  __ shellcheck --external-sources -- "$1"
}

__domfiles_dev_lint 'POSIX shell scripts' "$@"
