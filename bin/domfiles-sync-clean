#!/bin/sh

# shellcheck source=bin/domlib
. "$(dirname "$(realpath "$0")")/domlib"

__print_heading_dimmed 'Cleaning up'

__ rm -f "$HOME/.bash_history"
__ rm -f "$HOME/.lesshst"
__ rm -f "$HOME/.npmrc"
__ rm -f "$HOME/.ssh/.aiexclude"
__ rm -f "$HOME/.ssh/known_hosts.old"
__ rm -f "$HOME/.vim/autoload/plug.vim.old"
__ rm -f "$HOME/.viminfo"
__ rm -f "$HOME/.zsh_history"

# shellcheck disable=SC2066
for symlink in "$HOME/Library/Preferences/pnpm/config.yaml"; do
  if [ -L "$symlink" ]; then
    __ rm -f "$symlink"
  fi
done
