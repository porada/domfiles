#!/bin/sh

# shellcheck source=bin/domlib
. "$(dirname "$(realpath "$0")")/domlib"

# Nicer `git show`
if [ $# -eq 0 ]; then
  set -- HEAD
fi

if [ $# -eq 1 ] && __git_is_commit_reference "$1"; then
  __git_cd_root
  excluded_paths="$({
    __git_diff_excluded_files \
      | while IFS= read -r file; do
        if __git_is_file_in_commit "$1" "$file"; then
          echo "$file"
        else
          status="$?"
          [ "$status" -eq 1 ] || exit "$status"
        fi
      done
  })"

  if [ -n "$excluded_paths" ]; then
    exclude_params="$({
      printf '%s\n' "$excluded_paths" \
        | while IFS= read -r path; do
          echo ":(exclude)$path"
        done
    })"

    excluded_paths="$({
      __git_diff_excluded_files --related \
        | while IFS= read -r file; do
          if __git_is_file_in_commit "$1" "$file"; then
            echo "$file"
          else
            status="$?"
            [ "$status" -eq 1 ] || exit "$status"
          fi
        done
    })"

    # shellcheck disable=SC2086
    if git diff-tree --quiet --root "$1" -- . $exclude_params > /dev/null; then
      git show --show-signature "$1" -- $excluded_paths
      exit $?
    else
      status="$?"
      [ "$status" -eq 1 ] || exit "$status"
    fi

    # shellcheck disable=SC2086
    stat_output="$(git show --show-signature --stat --color=always "$1" -- $excluded_paths)" \
      || exit $?
    # shellcheck disable=SC2086
    patch_output="$(git show --pretty=format: --color=always "$1" -- . $exclude_params)" \
      || exit $?

    {
      printf '%s\n' "$stat_output"
      echo
      printf '%s\n' "$patch_output"
    } | __pager

    exit $?
  fi
fi

git show --show-signature "$@"
