#!/bin/sh

# shellcheck source=bin/domlib
. "$(dirname "$(realpath "$0")")/domlib"

# Show formatted `git show` output
if [ $# -eq 0 ]; then
  set -- HEAD
fi

if [ $# -eq 1 ] && __git_is_commit_reference "$1"; then
  __git_cd_root
  excluded_paths="$(__git_diff_list_changed_excluded_paths --commit "$1")"

  if [ -n "$excluded_paths" ]; then
    if git rev-parse --verify "$1^2" > /dev/null 2>&1; then
      # Preserve Git’s parent-qualified merge sections instead of splitting lockfile output
      git show --show-signature -m "$1"
      exit $?
    fi

    color_mode=never
    [ -t 1 ] && color_mode=always
    exclude_params="$(__git_diff_format_exclude_params "$excluded_paths")"
    excluded_paths="$(__git_diff_list_changed_excluded_paths --commit "$1" --related)"

    # shellcheck disable=SC2086
    if git diff-tree --quiet --root "$1" -- . $exclude_params > /dev/null; then
      git show --show-signature "$1" -- $excluded_paths
      exit $?
    else
      status="$?"
      [ "$status" -eq 1 ] || exit "$status"
    fi

    # shellcheck disable=SC2086
    stat_output="$(git show --show-signature --stat --color="$color_mode" "$1" -- $excluded_paths)" \
      || exit $?
    # shellcheck disable=SC2086
    patch_output="$(git show --pretty=format: --color="$color_mode" "$1" -- . $exclude_params)" \
      || exit $?

    __git_diff_page show "$stat_output" "$patch_output"
    exit $?
  fi
fi

git show --show-signature "$@"
