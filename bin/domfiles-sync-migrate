#!/bin/sh

# shellcheck source=domlib
. "$(dirname "$(realpath "$0")")/domlib"

# Migrate agent instructions
outdated_agent_instructions=false

for skill in github-cli package-release-notes prompt-relays prose \
  repository-harmonization technical-copy; do
  for path in "$HOME/.agents/skills/$skill" "$HOME/.claude/skills/$skill"; do
    if [ -L "$path" ]; then
      if [ "$outdated_agent_instructions" = false ]; then
        __print_heading_dimmed 'Cleaning up outdated agent instructions'
        outdated_agent_instructions=true
      fi

      __ rm -f "$path"
    fi
  done
done

# Migrate config paths
outdated_config_paths=false

for source in fish/local.fish gh git/allowed_signers npm/user.npmrc zed/prompts; do
  target="$DOMFILES_CONFIG_DIR/$source"
  source="$HOME/.config/$source"

  if [ -e "$source" ] && [ ! -e "$target" ]; then
    if [ "$outdated_config_paths" = false ]; then
      __print_heading_dimmed 'Migrating config paths'
      outdated_config_paths=true
    fi

    __ mv "$source" "$target"
  fi
done
