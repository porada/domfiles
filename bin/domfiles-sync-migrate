#!/bin/sh

# shellcheck source=bin/domlib
. "$(dirname "$(realpath "$0")")/domlib"

if [ -L "$HOME/.gitconfig" ]; then
  __print_heading_dimmed 'Removing outdated `git` config'
  __ rm -f "$HOME/.gitconfig"
fi

if __is_callable pnpm; then
  command_list="$(pnpm --dir "$HOME" --loglevel=error list --global --depth=0 --json)"

  for command in plugins skills; do
    if printf '%s\n' "$command_list" | grep -Fq -- "\"$command\":"; then
      __print_heading_dimmed "Removing \`$command\` installed through \`pnpm\`"
      __ pnpm --dir "$HOME" --loglevel=error remove --global "$command"
    fi
  done
fi

if [ -L "$HOME/.agents/skills/package-release-notes" ]; then
  __print_heading_dimmed 'Cleaning up outdated agent instructions'
  __ rm -f "$HOME/.agents/skills/package-release-notes"
fi
