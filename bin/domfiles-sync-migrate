#!/bin/sh

# shellcheck source=bin/domlib
. "$(dirname "$(realpath "$0")")/domlib"

if __is_callable fish && __is_fisher_installed && ! __is_brew_installed fisher; then
  __print_heading_dimmed 'Uninstalling `fisher`'

  fisher_config="$DOMFILES_FISH_CONFIG_DIR/fish_plugins"

  if [ -f "$fisher_config" ]; then
    echo 'jorgebucaran/fisher' >> "$fisher_config"
    __ fish --command 'fisher list | fisher remove' || true
  fi

  __ git -C "$DOMFILES" checkout HEAD -- "$fisher_config"
fi
