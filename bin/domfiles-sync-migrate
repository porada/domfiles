#!/bin/sh

# shellcheck source=bin/domlib
. "$(dirname "$(realpath "$0")")/domlib"

# Migrate `extra.fish`
if [ -f "$DOMFILES_FISH_CONFIG_DIR/extra.fish" ]; then
  __print_heading_dimmed 'Migrating `extra.fish`'
  __ mv "$DOMFILES_FISH_CONFIG_DIR/extra.fish" "$DOMFILES_FISH_CONFIG_DIR/local.fish"
fi

# Remove `pnpm` and `node` versions installed through Homebrew
for formula in node node@22 node@24 pnpm; do
  if __is_brew_installed "$formula"; then
    __print_heading_dimmed "Removing \`$formula\`"
    __ brew uninstall "$formula"
  fi
done

# Remove `gh`
if __is_brew_installed gh; then
  __print_heading_dimmed "Removing \`gh\`"
  __ brew uninstall gh
fi
