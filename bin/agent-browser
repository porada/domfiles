#!/bin/sh

# shellcheck source=bin/domlib
. "$(dirname "$(realpath "$0")")/domlib"

if printenv AGENT_BROWSER_CONFIG > /dev/null; then
  __print_error_and_exit \
    '`AGENT_BROWSER_CONFIG` is unsupported. Pass `--config <path>` instead'
fi

for name in ACTION_POLICY ALLOW_FILE_ACCESS ARGS AUTO_CONNECT CA_CERT CDP EXECUTABLE_PATH \
  EXTENSIONS IGNORE_HTTPS_ERRORS INIT_SCRIPTS IOS_DEVICE IOS_UDID PLUGINS PROFILE PROVIDER PROXY \
  PROXY_BYPASS SKILLS_DIR SOCKET_DIR STATE STATE_EXPIRE_DAYS STREAM_PORT; do
  name="AGENT_BROWSER_$name"

  if printenv "$name" > /dev/null; then
    __print_error_and_exit \
      "\`$name\` is unsupported. Pass an explicit parameter instead"
  fi
done

AGENT_BROWSER_CONFIG="$DOMFILES_CONFIG_DIR/agent-browser.json"
export AGENT_BROWSER_CONFIG
unset name

__domfiles_pnpm_exec agent-browser "$@"
