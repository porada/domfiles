#!/bin/sh

# Enable strict mode
set -eu

# Ensure the library is sourced only once
if [ -n "${DOMFILES_BIN_DIR-}" ]; then
  echo '`domlib` is already defined' >&2
  exit 1
fi

# Resolve common paths
DOMFILES_BIN_DIR="$(dirname "$(realpath "$0")")"
DOMFILES="$(dirname "$DOMFILES_BIN_DIR")"
# shellcheck disable=SC2034
DOMFILES_PROJECTS_DIR="$HOME/Projects"

# Resolve config paths
DOMFILES_CONFIG_DIR="$DOMFILES/.config"
# shellcheck disable=SC2034
DOMFILES_FISH_CONFIG_DIR="$DOMFILES_CONFIG_DIR/fish"
# shellcheck disable=SC2034
DOMFILES_GIT_CONFIG_DIR="$DOMFILES_CONFIG_DIR/git"
# shellcheck disable=SC2034
DOMFILES_NPM_CONFIG_DIR="$DOMFILES_CONFIG_DIR/npm"
# shellcheck disable=SC2034
DOMFILES_ZED_CONFIG_DIR="$DOMFILES_CONFIG_DIR/zed"

# Define helper variables and functions
DOMFILES_DEFAULT_IFS="$IFS"
DOMFILES_SSH_KEY="$HOME/.ssh/id_ed25519"
DOMFILES_VIM_PLUG="$HOME/.vim/autoload/plug.vim"

__() {
  if [ $# -eq 0 ]; then
    __print_error_and_exit '`__` requires at least one argument'
  fi

  if [ "$1" = 'brew' ]; then
    __print_command "$@"
    shift
    brew "$@"
  elif [ "$1" = 'pnpm' ]; then
    __print_command "$@"
    shift
    pnpm "$@"
  else
    __print_command "$@"
    command "$@"
  fi
}

__chmod() {
  if [ -d "$1" ]; then
    __ chmod 700 "$1"
  elif [ -f "$1" ]; then
    __ chmod 600 "$1"
  fi
}

__confirm() {
  if [ $# -ne 1 ]; then
    __print_error_and_exit '`__confirm` requires one argument'
  fi

  while true; do
    printf '%s %s\n' "$(__print_warning "$1")" "$(__print_info 'y/n')"

    if ! read -r response; then
      return 1
    fi

    case "$response" in
      y | Y)
        return 0
        ;;
      n | N)
        return 1
        ;;
    esac
  done
}

__domfiles() {
  if [ $# -eq 0 ]; then
    __print_error_and_exit '`__domfiles` requires at least one argument'
  fi

  command="$1"
  shift

  "$DOMFILES_BIN_DIR/domfiles-$command" "$@"
}

__domfiles_bin() {
  if [ $# -eq 0 ]; then
    __print_error_and_exit '`__domfiles_bin` requires at least one argument'
  fi

  command="$1"
  shift

  "$DOMFILES_BIN_DIR/$command" "$@"
}

__domfiles_cd_bin() {
  cd "$DOMFILES_BIN_DIR" \
    || __print_error_and_exit "Could not change directory to \`$DOMFILES_BIN_DIR\`"
}

__domfiles_cd_root() {
  cd "$DOMFILES" \
    || __print_error_and_exit "Could not change directory to \`$DOMFILES\`"
}

__domfiles_exec() {
  if [ $# -eq 0 ]; then
    __print_error_and_exit '`__domfiles_exec` requires at least one argument'
  fi

  command="$1"
  shift

  if [ "${1-}" = '--print' ]; then
    shift
    __print_command domfiles "$command" "$@"
  fi

  exec "$DOMFILES_BIN_DIR/domfiles-$command" "$@"
}

__domfiles_is_callable() {
  [ -x "$DOMFILES_BIN_DIR/domfiles-$1" ]
}

__domfiles_is_clean() {
  git -C "$DOMFILES" diff-index --quiet HEAD
}

__domfiles_ls_bin() {
  if [ $# -gt 0 ]; then
    pattern="$1"
  else
    pattern='*'
  fi

  (
    __domfiles_cd_bin
    find . -maxdepth 1 -type f -name "$pattern" -perm -u+x -exec basename {} \; \
      | sort \
      | xargs ls
  )
}

__domfiles_revision() {
  git -C "$DOMFILES" rev-parse HEAD
}

__find() {
  if [ $# -ne 2 ]; then
    __print_error_and_exit '`__find` requires two arguments'
  fi

  files="$(find "$1" -maxdepth 1 -name "$2" -type f -print | sort)"

  if [ -n "$files" ]; then
    printf '%s\n' "$files"
  else
    printf ''
  fi
}

__git_cd_root() {
  root="$(git rev-parse --show-toplevel)" || return $?

  cd "$root" \
    || __print_error_and_exit "Could not change directory to \`$root\`"

  unset root
}

__git_default_commit_count() {
  default=10
  count=0

  if git rev-parse --verify HEAD > /dev/null 2>&1; then
    count="$(git rev-list --count HEAD)"
  fi

  if [ "${1-}" = '--no-initial' ] && [ "$count" -gt 0 ]; then
    count="$((count - 1))"
  fi

  echo "$((count < default ? count : default))"
}

__git_default_log_params() {
  params="--date=format:'%Y-%m-%d / %H:%M' --pretty=format:'%C(dim)%h"
  [ "${1-}" != "--no-refs" ] && params="$params%C(reset)%C(red)%d"
  params="$params %C(reset)%s %C(dim)%cd / %an%C(reset)'"

  echo "$params"
}

__git_diff_excluded_files() {
  if [ "${1-}" = '--related' ]; then
    echo 'package.json'
  fi

  echo 'package-lock.json'
  echo 'pnpm-lock.yaml'
  echo 'yarn.lock'
}

__git_diff_excluded_paths() {
  if [ $# -eq 0 ]; then
    __print_error_and_exit '`__git_diff_excluded_paths` requires at least one argument'
  fi

  mode="$1"
  shift

  if [ "$mode" = '--commit' ]; then
    if [ $# -eq 0 ]; then
      __print_error_and_exit '`__git_diff_excluded_paths --commit` requires a reference'
    fi

    reference="$1"
    shift
  elif [ "$mode" != '--worktree' ]; then
    __print_error_and_exit '`__git_diff_excluded_paths` received an invalid mode'
  fi

  __git_diff_excluded_files "$@" \
    | while IFS= read -r file; do
      if [ "$mode" = '--commit' ]; then
        if __git_is_file_in_commit "$reference" "$file"; then
          echo "$file"
        else
          status="$?"
          [ "$status" -eq 1 ] || exit "$status"
        fi
      elif git diff-files --quiet -- "$file"; then
        continue
      else
        status="$?"

        if [ "$status" -eq 1 ]; then
          echo "$file"
        else
          exit "$status"
        fi
      fi
    done
}

__git_diff_exclude_params() {
  if [ $# -ne 1 ]; then
    __print_error_and_exit '`__git_diff_exclude_params` requires one argument'
  fi

  printf '%s\n' "$1" \
    | while IFS= read -r path; do
      echo ":(exclude)$path"
    done
}

__git_diff_page() {
  if [ $# -lt 2 ] || [ $# -gt 3 ]; then
    __print_error_and_exit '`__git_diff_page` requires two arguments and an optional `--leading-newline`'
  fi

  if [ $# -eq 3 ] && [ "$3" != '--leading-newline' ]; then
    __print_error_and_exit '`__git_diff_page` received an invalid option'
  fi

  {
    if [ "${3-}" = '--leading-newline' ]; then
      echo
    fi

    printf '%s\n' "$1"
    echo
    printf '%s\n' "$2"
  } | __pager
}

__git_is_commit_reference() {
  if git rev-parse --verify "$1^{commit}" > /dev/null 2>&1; then
    return 0
  else
    return 1
  fi
}

__git_is_file_in_commit() {
  if [ $# -ne 2 ]; then
    __print_error_and_exit '`__git_is_file_in_commit` requires two arguments'
  fi

  changed_files="$(git diff-tree --no-commit-id --name-only --root -r "$1" -- "$2")" \
    || return $?

  [ -n "$changed_files" ]
}

__git_skipped_files() {
  if [ $# -eq 0 ]; then
    __print_error_and_exit '`__git_skipped_files` requires at least one argument'
  fi

  repository="$1"
  shift

  root="$(git -C "$repository" rev-parse --show-toplevel)" || return $?
  files="$(git -C "$root" ls-files -v -- "$@")" || return $?
  printf '%s\n' "$files" | __grep '^[a-z]'
}

__grep() {
  if grep "$@"; then
    return 0
  else
    status="$?"
  fi

  [ "$status" -eq 1 ] && return 0
  return "$status"
}

__ifs_restore() {
  IFS="$DOMFILES_DEFAULT_IFS"
}

__ifs_set() {
  if [ "$IFS" != "$DOMFILES_DEFAULT_IFS" ]; then
    __print_error_and_exit '`IFS` is already being overridden'
  fi

  if [ $# -eq 1 ]; then
    IFS="$1"
  else
    IFS='
'
  fi
}

__is_brew_installed() {
  if [ $# -eq 0 ]; then
    brew --version > /dev/null 2>&1
  else
    brew list | grep -q "^$1\$" 2> /dev/null
  fi
}

__is_brew_keg_only() {
  brew info "$1" --json=v2 2> /dev/null | grep -q '"keg_only": true'
}

__is_brew_linked() {
  brew info "$1" --json=v2 2> /dev/null | grep -q '"linked_keg": "[^"]'
}

__is_callable() {
  sh -c "command -v \"$1\"" > /dev/null 2>&1
}

__is_ci() {
  [ -n "${CI-}" ] || [ -n "${GITHUB_ACTIONS-}" ]
}

__is_fish() {
  __is_shell "$(brew --prefix)/bin/fish"
}

__is_fisher_installed() {
  fish --command 'fisher --version' > /dev/null 2>&1
}

__is_macos() {
  [ "$(uname -s)" = 'Darwin' ]
}

__is_shell() {
  [ "${1-}" = "$SHELL" ]
}

__is_ssh_configured() {
  [ -f "$DOMFILES_SSH_KEY" ] && [ -f "$DOMFILES_SSH_KEY.pub" ]
}

__is_tty() {
  [ -t 0 ] && [ -t 1 ]
}

__is_uint() {
  case "$1" in
    '' | *[!0123456789]*)
      return 1
      ;;
    *)
      return 0
      ;;
  esac
}

__is_vim_plug_installed() {
  [ -s "$DOMFILES_VIM_PLUG" ] && grep -q '[^[:space:]]' "$DOMFILES_VIM_PLUG"
}

__mkdir() {
  __ mkdir -p "$1"
  __chmod "$1"
}

__pager() {
  if [ -n "${PAGER-}" ]; then
    sh -c "$PAGER"
  elif __is_callable less; then
    less
  else
    cat
  fi
}

__print_command() {
  __print_info "\$ $(__quote_params "$@")" >&2
}

__print_confirmation() {
  __print_info "✓ $*"
}

__print_error() {
  __printf '\033[0;31m× %s\033[0m\n' "$*" >&2
}

__print_error_and_exit() {
  __print_error "$*"
  exit 1
}

__print_heading() {
  __printf '\n\033[1;33m· %s\033[0m\n' "$*"
}

__print_heading_dimmed() {
  __printf '\n\033[1;2m· %s\033[0m\n' "$*"
}

__print_info() {
  __printf '\033[2m%s\033[0m\n' "$*"
}

__print_info_and_exit() {
  __print_info "$*"
  exit 0
}

__print_success() {
  __printf '\033[0;32m✓ %s\033[0m\n' "$*"
}

__print_url() {
  __print_info "↓ $*"
}

__print_warning() {
  __printf '\033[1m▴ %s\033[0m\n' "$*"
}

__printf() {
  if [ $# -eq 0 ]; then
    printf ''
    return 0
  fi

  format="${1-}"
  shift

  if [ -n "$format" ]; then
    # shellcheck disable=SC2059
    printf "$format" "$(__string_replace "$HOME" '~' "$*")"
  fi
}

__quote_params() {
  python3 -c '
import shlex, sys
params = (shlex.quote(param) for param in sys.argv[1:])
sys.stdout.write(" ".join(params))' "$@"
}

__ssh_add() {
  __print_command 'ssh-add' "$@"
  ssh-add "$@" > /dev/null 2>&1 || __print_error 'Failed to add the SSH key'
}

__string_contains() {
  if printf '%s' "$1" | grep -F -q -- "$2"; then
    return 0
  else
    return 1
  fi
}

__string_replace() {
  if [ $# -ne 3 ]; then
    __print_error_and_exit '`__string_replace` requires three arguments'
  fi

  if [ -z "$1" ]; then
    __print_error_and_exit '`__string_replace` pattern can’t be empty'
  fi

  if ! __string_contains "$3" "$1"; then
    printf '%s\n' "$3"
    return 0
  fi

  python3 -c '
import sys
pattern, replacement, subject = sys.argv[1:4]
sys.stdout.write(subject.replace(pattern, replacement))' "$@"
}

__symlink() {
  parent="$(dirname "$2")"

  if [ -d "$parent" ]; then
    source_path="$(realpath "$(dirname "$1")")/$(basename "$1")"
    destination_path="$(realpath "$parent")/$(basename "$2")"

    case "$source_path" in
      "$destination_path" | "$destination_path"/*)
        __print_error_and_exit \
          "Cannot replace \`$destination_path\` because it contains \`$source_path\`"
        ;;
    esac

    rm -rf "$2"
  else
    __mkdir "$parent"
  fi

  __ ln -s "$1" "$2"
}

__touch() {
  parent="$(dirname "$1")"
  [ -d "$parent" ] || __mkdir "$parent"

  __ touch "$1"
  __chmod "$1"
}

brew() {
  command='brew'

  if ! __is_callable "$command"; then
    command='/opt/homebrew/bin/brew'
    [ -x "$command" ] || __print_error_and_exit '`brew` is missing'
  fi

  HOMEBREW_NO_ASK=1 HOMEBREW_NO_AUTO_UPDATE=1 command "$command" "$@"
}

pnpm() {
  if ! __is_callable pnpm; then
    __print_error_and_exit '`pnpm` is missing'
  fi

  PATH="$HOME/Library/pnpm/bin:$PATH" command pnpm "$@"
}
