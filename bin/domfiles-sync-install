#!/bin/sh

# shellcheck source=bin/domlib
. "$(dirname "$(realpath "$0")")/domlib"

__print_heading "Installing dependencies"
__is_ci && __ brew --version
__ brew analytics off

__print_heading_dimmed 'Ensuring `brew` is up to date'
__ brew update --quiet

if __is_ci; then
  __ brew --version
else
  __ brew upgrade --overwrite || true
fi

install() {
  if ! __is_brew_installed "$1"; then
    __print_heading "Installing \`$1\`"
    __ brew install --quiet "$1"
  fi

  if __is_brew_keg_only "$1"; then
    __print_heading_dimmed "Ensuring \`$1\` is linked"
    __ brew unlink --quiet "$1" || true
    __ brew link --quiet --overwrite --force "$1"
  fi
}

# Install primary dependencies
for formula in fish git mole vim; do
  install "$formula"
done

# Install development dependencies
if ! __is_ci; then
  for formula in fd jq ripgrep shellcheck yarn; do
    install "$formula"
  done
fi

# Clean up `brew` cache
__ brew cleanup --scrub --quiet
__ rm -rf "$(brew --cache)"

# Install `fisher`
if __is_callable fish && ! __is_fisher_installed; then
  __print_heading 'Installing `fisher`'

  url='https://raw.githubusercontent.com/jorgebucaran/fisher/main/functions/fisher.fish'
  __print_url "$url"

  curl --fail --location "$url" \
    | fish --command 'source /dev/stdin && fisher install jorgebucaran/fisher'
fi

# Install `pnpm`
if ! __is_callable pnpm; then
  __print_heading 'Installing `pnpm`'

  # Back up `config.fish` first as the installer may modify it
  config="$(mktemp)"
  __ cp "$DOMFILES_FISH_CONFIG_DIR/config.fish" "$config"

  url='https://get.pnpm.io/install.sh'
  __print_url "$url"

  curl --fail --location "$url" | env PNPM_VERSION='11.0.0' sh -

  # Restore `config.fish`
  if [ -f "$config" ]; then
    __ cp "$config" "$DOMFILES_FISH_CONFIG_DIR/config.fish"
    __ rm -f "$config"
  fi
fi

# Update `pnpm`
__print_heading_dimmed 'Ensuring `pnpm` is up to date'
__ pnpm --dir "$HOME" --silent self-update latest-11

# Install `pnpm` completions
if __is_callable pnpm; then
  __print_heading_dimmed 'Installing `pnpm` completions'
  __mkdir "$DOMFILES_FISH_CONFIG_DIR/completions"
  pnpm completion fish > "$DOMFILES_FISH_CONFIG_DIR/completions/pnpm.fish"
  __print_confirmation 'pnpm completion fish'
fi

# Install `node`
if __is_callable pnpm; then
  __print_heading_dimmed 'Installing `node`'
  __ pnpm --silent env use --global lts
fi

# Install `skills`
if __is_callable pnpm; then
  __print_heading_dimmed 'Installing `skills`'
  __ pnpm --silent install --global skills
fi

# Install `vim-plug`
if __is_callable vim && ! __is_vim_plug_installed; then
  __print_heading 'Installing `vim-plug`'

  url='https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim'
  __print_url "$url"

  curl --fail --location "$url" --output "$DOMFILES_VIM_PLUG" --create-dirs
  __print_confirmation "$DOMFILES_VIM_PLUG"
fi

# Set `fish` as the default shell
fish="$(brew --prefix)/bin/fish"
__is_shell "$fish" && exit 0

# Skip in non-interactive shells
if __is_ci || ! __is_tty; then
  exit 0
fi

if ! grep -qFx -- "$fish" /etc/shells; then
  __print_heading 'Adding `fish` to `/etc/shells`'
  __ sudo sh -c "echo \"$fish\" >> /etc/shells" || true
fi

__print_heading_dimmed 'Setting up `fish` as the default shell'

if __ chsh -s "$fish"; then
  __print_confirmation "$fish"
else
  __print_error "Failed to set \`$fish\` as the default shell"
fi
