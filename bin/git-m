#!/bin/sh

# shellcheck source=domlib
. "$(dirname "$(realpath "$0")")/domlib"

# Switch to the repository’s primary branch
branch=''

for param in main trunk master; do
  if git show-ref --verify --quiet "refs/heads/$param"; then
    branch="$param"
    break
  else
    status="$?"
    [ "$status" -eq 1 ] || exit "$status"
  fi
done

if [ -z "$branch" ]; then
  __print_error_and_exit 'Failed to find the main branch'
fi

__ git checkout "$branch"
