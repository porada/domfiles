#!/bin/sh

# shellcheck source=bin/domlib
. "$(dirname "$(realpath "$0")")/domlib"

# Rebase the requested number of most recent commits
available=0
count_param=''
manual=false

__git_cd_root

for param in "$@"; do
  if [ "$param" = '--manual' ]; then
    manual=true
  elif [ -z "$count_param" ]; then
    count_param="$param"
  fi
done

# Ignore invalid arguments for simplicity
if __is_uint "$count_param"; then
  count="$count_param"
else
  count="$(git rev-list --first-parent --count '@{u}..HEAD' 2> /dev/null || true)"
  [ -z "$count" ] && count="$(__git_default_commit_count --no-initial)"
fi

# Ensure the repository has a `HEAD` first
if __git_is_commit_reference HEAD; then
  available="$(git rev-list --first-parent --count HEAD)"
fi

# Account for the initial commit
if [ "$available" -gt 0 ]; then
  available="$((available - 1))"
fi

if [ "$available" -le 0 ] || [ "$count" -le 0 ]; then
  __print_info_and_exit 'No commits to rebase'
fi

if [ "$count" -gt "$available" ]; then
  count="$available"
fi

if [ "$manual" = true ]; then
  git rebase --interactive --no-autosquash "HEAD~$count"
else
  git rebase --interactive "HEAD~$count"
fi
