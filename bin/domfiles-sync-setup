#!/bin/sh

# shellcheck source=bin/domlib
. "$(dirname "$(realpath "$0")")/domlib"

__print_heading 'Linking domfiles'

__symlink "$DOMFILES_CONFIG_DIR" "$HOME/.config"

for source in .curlrc .gitconfig .vimrc; do
  __symlink "$DOMFILES_CONFIG_DIR/$source" "$HOME/$source"
done

__print_heading_dimmed 'Linking agent instructions'

for source in agent-documentation github-cli release-notes repository-harmonization technical-copy; do
  __symlink "$DOMFILES_SKILLS_DIR/$source" "$HOME/.agents/skills/$source"
done

__symlink "$DOMFILES_ZED_CONFIG_DIR/AGENTS.md" "$HOME/.codex/AGENTS.md"

__print_heading_dimmed 'Provisioning additional files'

__mkdir "$DOMFILES_PROJECTS_DIR"
__touch "$DOMFILES_FISH_CONFIG_DIR/local.fish"
__touch "$DOMFILES_GIT_CONFIG_DIR/allowed_signers"
__touch "$DOMFILES_NPM_CONFIG_DIR/user.npmrc"
__touch "$HOME/.hushlogin"

__print_heading_dimmed 'Ensuring proper permissions'

__chmod "$DOMFILES"
__chmod "$HOME/.ssh"

__print_heading_dimmed 'Verifying SSH setup'

if ! __is_ssh_configured; then
  __print_error 'No SSH key pair found'
else
  __print_confirmation "$DOMFILES_SSH_KEY"

  # Set up allowed signers for `git`
  signer="$(git config --global --get user.email 2> /dev/null || true)"

  if [ -z "$signer" ]; then
    __print_error_and_exit 'Could not resolve `user.email` from `.gitconfig`'
  fi

  read -r type key _ < "$DOMFILES_SSH_KEY.pub"
  printf '%s namespaces="git" %s %s\n' "$signer" "$type" "$key" \
    > "$DOMFILES_GIT_CONFIG_DIR/allowed_signers"

  __print_confirmation "$DOMFILES_GIT_CONFIG_DIR/allowed_signers"
fi
